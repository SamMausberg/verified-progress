# --- Private: never commit ---
/Sam's Inco Take Home Challenge.pdf
/writing.md
# Presentation decks and any other PDF at the top level (the paper's PDFs live in paper/); the
# talk's deck in presentation/ is committed
/*.pdf
*.pptx
!/presentation/*.pptx

# Python
.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# LaTeX build artifacts of the paper and the research notes (both PDFs are tracked)
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
paper/*.bbl
paper/*.blg
# Fetched at build time and hash-checked; no licence to redistribute (paper/template/README.md)
paper/template/mlsys2025.sty

# Lean build output
formal/.lake/
formal/build/

# Raw GPU run output stays outside git, under ~/vp-data/ (RUNBOOK.md, section 6);
# these catch a run or profile written into the checkout by mistake. Only the top-level runs/
# is ignored: experiments/repair/runs/ holds that experiment's committed hold scripts.
/runs/
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite

# Secrets, editors and OS files
.env
.env.*
.vscode/
.idea/
.DS_Store
