From 1bc2fc4719086a2eb0c2b41c486cea182f35b286 Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Fri, 2 Oct 2026 17:56:28 +0000
Subject: [PATCH] FP8 dense: timing-only oracle mode
 (SGLANG_FP8_DENSE_ACT=oracle)

The GEMMs read a fixed random FP8 activation buffer, so no quantization or
row-scale kernel runs. Outputs are invalid; the mode bounds the served gain
of a fused-quantization design.
---
 .../layers/quantization/fp8_dense_online.py   | 27 +++++++++++++++++--
 1 file changed, 25 insertions(+), 2 deletions(-)

diff --git a/python/sglang/srt/layers/quantization/fp8_dense_online.py b/python/sglang/srt/layers/quantization/fp8_dense_online.py
index 26ae22cdaf..0404fc683f 100644
--- a/python/sglang/srt/layers/quantization/fp8_dense_online.py
+++ b/python/sglang/srt/layers/quantization/fp8_dense_online.py
@@ -15,6 +15,9 @@ SGLANG_FP8_DENSE_ACT selects the activation scale:
   tensor one scale for the whole batch (its maximum), passed to cuBLASLt. One kernel fewer per
          layer, but each row's result depends on the other rows in the batch, padded CUDA-graph
          rows included.
+  oracle TIMING ONLY, OUTPUTS INVALID: the GEMM reads a fixed random FP8 activation buffer, so no
+         quantization or row-scale kernel runs. It bounds what a fused design (quantization inside
+         the producing norm/activation kernel, scales in the GEMM epilogue) could gain.
 SGLANG_FP8_DENSE_SKIP is a comma-separated list of module-name substrings that stay BF16
 (default: in_proj_ba,visual).
 """
@@ -31,7 +34,8 @@ logger = logging.getLogger(__name__)
 FP8 = torch.float8_e4m3fn
 FP8_MAX = float(torch.finfo(FP8).max)
 _MODES = ("target", "draft", "both")
-_ACTS = ("token", "tensor")
+_ACTS = ("token", "tensor", "oracle")
+_ORACLE_ROWS = 32768
 
 
 def _per_token_quant(x: torch.Tensor):
@@ -52,13 +56,23 @@ class Fp8DenseOnlineLinearMethod:
 
     def __init__(self, act: str):
         self.act = act
+        self.oracle_inputs: dict = {}
 
     def apply(self, layer, x: torch.Tensor, bias=None) -> torch.Tensor:
         shape = x.shape
         x2 = x.reshape(-1, shape[-1])
         if not x2.is_contiguous():
             x2 = x2.contiguous()
-        if self.act == "token":
+        if self.act == "oracle":
+            q = self.oracle_inputs[x2.shape[1]][: x2.shape[0]]
+            out = torch._scaled_mm(
+                q,
+                layer.weight_fp8_t,
+                scale_a=layer.fp8_one,
+                scale_b=layer.weight_scale_fp8,
+                out_dtype=x.dtype,
+            )
+        elif self.act == "token":
             q, xs = _per_token_quant(x2)
             out = torch._scaled_mm(
                 q,
@@ -125,8 +139,17 @@ def maybe_convert_dense_to_fp8(model: torch.nn.Module, is_draft_worker: bool) ->
             torch.empty(0, dtype=w.dtype, device=w.device), requires_grad=False
         )
         module.quant_method = method
+        if act == "oracle" and k not in method.oracle_inputs:
+            method.oracle_inputs[k] = torch.randn(_ORACLE_ROWS, k, device=w.device).to(
+                FP8
+            )
         converted += 1
     torch.cuda.empty_cache()
+    if act == "oracle":
+        logger.warning(
+            "FP8 dense ORACLE mode: GEMMs read a fixed random FP8 input; "
+            "outputs are INVALID (timing only)."
+        )
     logger.info(
         "FP8 dense (%s, act=%s, %s): converted %d linear layers, %.2f GB -> %.2f GB; "
         "kept BF16: %s",
-- 
2.34.1

