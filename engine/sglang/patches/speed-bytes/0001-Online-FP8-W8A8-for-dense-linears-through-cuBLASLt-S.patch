From 98aa8c9821bc5d9186ab1b42ca84184ddafeac44 Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Fri, 2 Oct 2026 17:11:13 +0000
Subject: [PATCH] Online FP8 W8A8 for dense linears through cuBLASLt
 (SGLANG_FP8_DENSE)

Converts every unquantized linear of the target, the draft model or both
to float8_e4m3fn with a per-tensor weight scale after loading, and runs it
with torch._scaled_mm (scalar scales, cuBLASLt). Activation scales are per
row (default, applied after the GEMM) or per tensor. Avoids the sgl-kernel
CUTLASS sm90a FP8 GEMM, which the aarch64 wheel lacks.
---
 .../layers/quantization/fp8_dense_online.py   | 140 ++++++++++++++++++
 .../sglang/srt/model_executor/model_runner.py |   6 +
 2 files changed, 146 insertions(+)
 create mode 100644 python/sglang/srt/layers/quantization/fp8_dense_online.py

diff --git a/python/sglang/srt/layers/quantization/fp8_dense_online.py b/python/sglang/srt/layers/quantization/fp8_dense_online.py
new file mode 100644
index 0000000000..26ae22cdaf
--- /dev/null
+++ b/python/sglang/srt/layers/quantization/fp8_dense_online.py
@@ -0,0 +1,140 @@
+"""Online FP8 (W8A8) for dense linear layers through cuBLASLt, selected by environment.
+
+SGLANG_FP8_DENSE=target|draft|both converts, after loading, every linear layer that would
+otherwise run SGLang's unquantized BF16 path in the target model, the speculative draft model,
+or both. Each weight becomes float8_e4m3fn with one FP32 scale per tensor (its absolute maximum
+over 448), and the layer then runs torch._scaled_mm with scalar scales, which dispatches to
+cuBLASLt. On aarch64 GH200 builds of sgl-kernel the default `--quantization fp8` path selects a
+CUTLASS sm90a kernel that the wheel does not contain and aborts; this route needs no sgl-kernel
+GEMM.
+
+SGLANG_FP8_DENSE_ACT selects the activation scale:
+  token  (default) one scale per row, applied to the BF16 GEMM output afterwards. A row's result
+         does not depend on the other rows of the batch (beyond the cuBLAS kernel choice for M,
+         as with BF16). The output is rounded to BF16 twice (GEMM, then the row scale).
+  tensor one scale for the whole batch (its maximum), passed to cuBLASLt. One kernel fewer per
+         layer, but each row's result depends on the other rows in the batch, padded CUDA-graph
+         rows included.
+SGLANG_FP8_DENSE_SKIP is a comma-separated list of module-name substrings that stay BF16
+(default: in_proj_ba,visual).
+"""
+
+import logging
+import os
+
+import torch
+
+from sglang.srt.layers.quantization.unquant import UnquantizedLinearMethod
+
+logger = logging.getLogger(__name__)
+
+FP8 = torch.float8_e4m3fn
+FP8_MAX = float(torch.finfo(FP8).max)
+_MODES = ("target", "draft", "both")
+_ACTS = ("token", "tensor")
+
+
+def _per_token_quant(x: torch.Tensor):
+    from sglang.kernels.ops.quantization.fp8_kernel import sglang_per_token_quant_fp8
+
+    return sglang_per_token_quant_fp8(x)
+
+
+def _per_tensor_quant(x: torch.Tensor):
+    from sglang.kernels.ops.quantization.fp8_kernel import scaled_fp8_quant
+
+    q, s = scaled_fp8_quant(x, None)
+    return q, s.reshape(())
+
+
+class Fp8DenseOnlineLinearMethod:
+    """Replaces UnquantizedLinearMethod.apply on a converted layer."""
+
+    def __init__(self, act: str):
+        self.act = act
+
+    def apply(self, layer, x: torch.Tensor, bias=None) -> torch.Tensor:
+        shape = x.shape
+        x2 = x.reshape(-1, shape[-1])
+        if not x2.is_contiguous():
+            x2 = x2.contiguous()
+        if self.act == "token":
+            q, xs = _per_token_quant(x2)
+            out = torch._scaled_mm(
+                q,
+                layer.weight_fp8_t,
+                scale_a=layer.fp8_one,
+                scale_b=layer.weight_scale_fp8,
+                out_dtype=x.dtype,
+            )
+            out.mul_(xs)
+        else:
+            q, xs = _per_tensor_quant(x2)
+            out = torch._scaled_mm(
+                q,
+                layer.weight_fp8_t,
+                scale_a=xs,
+                scale_b=layer.weight_scale_fp8,
+                out_dtype=x.dtype,
+            )
+        if bias is not None:
+            out = out + bias
+        return out.view(*shape[:-1], out.shape[-1])
+
+
+def maybe_convert_dense_to_fp8(model: torch.nn.Module, is_draft_worker: bool) -> None:
+    mode = os.environ.get("SGLANG_FP8_DENSE", "").strip()
+    if not mode:
+        return
+    if mode not in _MODES:
+        raise ValueError(f"SGLANG_FP8_DENSE={mode!r}; expected one of {_MODES}")
+    if mode == "target" and is_draft_worker or mode == "draft" and not is_draft_worker:
+        return
+    act = os.environ.get("SGLANG_FP8_DENSE_ACT", "token").strip()
+    if act not in _ACTS:
+        raise ValueError(f"SGLANG_FP8_DENSE_ACT={act!r}; expected one of {_ACTS}")
+    skip = [
+        s
+        for s in os.environ.get("SGLANG_FP8_DENSE_SKIP", "in_proj_ba,visual").split(",")
+        if s
+    ]
+    method = Fp8DenseOnlineLinearMethod(act)
+    converted, skipped, bytes_before, bytes_after = 0, [], 0, 0
+    for name, module in model.named_modules():
+        qm = getattr(module, "quant_method", None)
+        if type(qm) is not UnquantizedLinearMethod:
+            continue
+        w = getattr(module, "weight", None)
+        if w is None or w.dim() != 2 or w.dtype not in (torch.bfloat16, torch.float16):
+            continue
+        n, k = w.shape
+        if any(s in name for s in skip) or n % 16 or k % 16:
+            skipped.append(name)
+            continue
+        with torch.no_grad():
+            scale = (w.abs().amax().float() / FP8_MAX).clamp(min=1e-12)
+            wq = (w.float() / scale).clamp(-FP8_MAX, FP8_MAX).to(FP8)
+        bytes_before += w.numel() * w.element_size()
+        bytes_after += wq.numel()
+        # Column-major [K, N] view, as torch._scaled_mm requires for its second operand.
+        module.weight_fp8_t = wq.t()
+        module.weight_scale_fp8 = scale.reshape(())
+        module.fp8_one = torch.ones((), dtype=torch.float32, device=w.device)
+        # Free the BF16 weight; nothing on the converted path reads it.
+        module.weight = torch.nn.Parameter(
+            torch.empty(0, dtype=w.dtype, device=w.device), requires_grad=False
+        )
+        module.quant_method = method
+        converted += 1
+    torch.cuda.empty_cache()
+    logger.info(
+        "FP8 dense (%s, act=%s, %s): converted %d linear layers, %.2f GB -> %.2f GB; "
+        "kept BF16: %s",
+        mode,
+        act,
+        "draft" if is_draft_worker else "target",
+        converted,
+        bytes_before / 1e9,
+        bytes_after / 1e9,
+        ", ".join(skipped) if skipped else "none",
+    )
diff --git a/python/sglang/srt/model_executor/model_runner.py b/python/sglang/srt/model_executor/model_runner.py
index bc1d618af4..e2c2b3b6f7 100644
--- a/python/sglang/srt/model_executor/model_runner.py
+++ b/python/sglang/srt/model_executor/model_runner.py
@@ -1248,6 +1248,12 @@ class ModelRunner:
         if not self.is_draft_worker:
             get_offloader().post_init()
 
+        from sglang.srt.layers.quantization.fp8_dense_online import (
+            maybe_convert_dense_to_fp8,
+        )
+
+        maybe_convert_dense_to_fp8(self.model, self.is_draft_worker)
+
         self.maybe_precompile_model_kernels_after_loading()
 
         # Register model for layerwise NVTX profiling if enabled
-- 
