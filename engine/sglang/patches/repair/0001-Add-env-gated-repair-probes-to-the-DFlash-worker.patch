+    # --- Repair workstream probes (env-gated; see repair_probe.py). ---
+
+    def _get_repair_probe(self) -> RepairProbe:
+        if self._repair_probe is None:
+            num_slots = int(self.model_runner.req_to_token_pool.req_to_token.shape[0])
+            self._repair_probe = RepairProbe(
+                self.device, num_slots, int(self.block_size)
+            )
+        return self._repair_probe
+
+    def _repair_snapshot_state(self, req_pool_indices: torch.Tensor):
+        """Copy the committed GDN conv and SSM states of this batch's slots.
+
+        The verify conv kernel shifts the committed conv window in place (the
+        commit later overwrites it from the per-step windows), so a second
+        verify pass on the same prefix must start from a restored copy.
+        """
+        if not self._need_mamba_verify_commit:
+            return None
+        pool = self.target_worker.model_runner.req_to_token_pool
+        idx = pool.translate_mamba_indices(pool.get_mamba_indices(req_pool_indices))
+        idx = idx.to(torch.int64)
+        caches = pool.get_speculative_mamba2_params_all_layers()
+        conv = [c[:, idx].clone() for c in caches.conv]
+        ssm = caches.temporal[:, idx].clone()
+        return idx, caches, conv, ssm
+
+    @staticmethod
+    def _repair_restore_state(saved) -> None:
+        if saved is None:
+            return
+        idx, caches, conv, ssm = saved
+        for dst, src in zip(caches.conv, conv):
+            dst[:, idx] = src
+        caches.temporal[:, idx] = ssm
+
+    def _repair_verify(self, verify_forward_batch, saved_state, sampling_info):
+        self._repair_restore_state(saved_state)
+        out = self.target_worker.forward_batch_generation(
+            batch=None,
+            forward_batch=verify_forward_batch,
+            is_verify=True,
+            skip_attn_backend_init=True if not _is_npu else None,
+        )
+        if sampling_info is not None:
+            apply_dflash_verify_logits_adjustments(
+                next_token_logits=out.logits_output.next_token_logits,
+                sampling_info=sampling_info,
+                draft_token_num=int(self.block_size),
+            )
+        return out
+
+    def _repair_sweeps(
+        self,
+        *,
+        repair: RepairProbe,
+        draft_tokens: torch.Tensor,
+        verify_forward_batch,
+        target_out,
+        sampling_info,
+        bs: int,
+        saved_state,
+    ):
+        """Record Jacobi sweeps from this block's draft, then restore the draft pass.
+
+        Every pass is a full target verify of the whole block from the same
+        committed prefix. "recycle" sweeps set y'_j = argmax F(y)_{j-1} for
+        j >= 1; "keep" sweeps only replace the first mismatching draft token by
+        the target's token. The block that is finally verified and committed is
+        the original draft, so the decoding trajectory is plain DFlash.
+        """
+        block = int(self.block_size)
+        if sampling_info is not None:
+            apply_dflash_verify_logits_adjustments(
+                next_token_logits=target_out.logits_output.next_token_logits,
+                sampling_info=sampling_info,
+                draft_token_num=block,
+            )
+
+        def predict(out):
+            return torch.argmax(out.logits_output.next_token_logits, dim=-1).view(
+                bs, block
+            )
+
+        def accept(y, t):
+            a, _ = compute_dflash_correct_drafts_and_bonus(
+                candidates=y, target_predict=t
+            )
+            return a.to(torch.int64)
+
+        y0 = draft_tokens.clone()
+        t0 = predict(target_out)
+        a0 = accept(y0, t0)
+        rec = {"recycle": [], "keep": []}
+
+        y, t = y0, t0
+        for _ in range(repair.sweeps):
+            y_next = y.clone()
+            y_next[:, 1:] = t[:, :-1]
+            draft_tokens.copy_(y_next)
+            out = self._repair_verify(verify_forward_batch, saved_state, sampling_info)
+            t_next = predict(out)
+            rec["recycle"].append((y_next, t_next, accept(y_next, t_next)))
+            y, t = y_next, t_next
+
+        rows = torch.arange(bs, device=draft_tokens.device)
+        z, tz, az = y0, t0, a0
+        for _ in range(repair.sweeps):
+            z_next = z.clone()
+            idx = (az + 1).clamp(max=block - 1)
+            fix = az < block - 1
+            z_next[rows, idx] = torch.where(fix, tz[rows, idx - 1], z[rows, idx])
+            draft_tokens.copy_(z_next)
+            out = self._repair_verify(verify_forward_batch, saved_state, sampling_info)
+            tz_next = predict(out)
+            az_next = accept(z_next, tz_next)
+            rec["keep"].append((z_next, tz_next, az_next))
+            z, tz, az = z_next, tz_next, az_next
+
+        draft_tokens.copy_(y0)
+        target_out = self._repair_verify(verify_forward_batch, saved_state, None)
+        # The restored pass must reproduce the first pass bit for bit.
+        rec["replay_mismatch"] = (predict(target_out) != t0).sum(dim=1)
+        return target_out, rec
+
+    def _repair_write_trace(
+        self,
+        *,
+        repair: RepairProbe,
+        batch: ScheduleBatch,
+        prefix_lens: torch.Tensor,
+        fresh_tokens: Optional[torch.Tensor],
+        candidates: torch.Tensor,
+        target_predict: torch.Tensor,
+        accept_len: torch.Tensor,
+        commit_lens: torch.Tensor,
+        sweep_record,
+    ) -> None:
+        bs = candidates.shape[0]
+        fields = {
+            "prefix": prefix_lens[:bs].tolist(),
+            "cand": candidates.tolist(),
+            "tpred": target_predict.tolist(),
+            "accept": accept_len.tolist(),
+            "commit": commit_lens.tolist(),
+        }
+        if fresh_tokens is not None:
+            fields["fresh"] = fresh_tokens.tolist()
+        sweeps = None
+        if sweep_record is not None:
+            sweeps = {
+                kind: [
+                    (y.tolist(), t.tolist(), a.tolist())
+                    for (y, t, a) in sweep_record[kind]
+                ]
+                for kind in ("recycle", "keep")
+            }
+            fields["replay_mismatch"] = sweep_record["replay_mismatch"].tolist()
+        for i, req in enumerate(batch.reqs[:bs]):
+            record = {k: v[i] for k, v in fields.items()}
+            record["rid"] = req.rid
+            record["out_len"] = len(req.output_ids)
+            if sweeps is not None:
+                record["sweeps"] = {
+                    kind: [[y[i], t[i], a[i]] for (y, t, a) in passes]
+                    for kind, passes in sweeps.items()
+                }
+            repair.trace.write(record)
+
