--- /dev/null
+++ b/python/sglang/srt/speculative/repair_probe.py
@@ -0,0 +1,311 @@
+"""Oracle and repair probes for the DFlash worker (repair workstream).
+
+Everything here is off unless one of these environment variables is set:
+
+SGLANG_REPAIR_TIMING_LOG=<path>
+    Append one JSON line per decode cycle with GPU phase times measured by CUDA
+    events (draft, control, verify, accept, commit, append) and the GPU-timeline
+    start of the cycle, so gaps between cycles are visible. Events are resolved
+    lazily with ``Event.query()``; the probe never synchronizes the host.
+
+SGLANG_REPAIR_ORACLE=<path.json>
+    Replace the drafted block with a reference continuation. The file holds
+    ``{"refs": [{"input_ids": [...], "continuation": [...]}, ...]}``; a request
+    whose prompt ids equal ``input_ids`` gets draft token j of each block set to
+    ``(input_ids + continuation)[seq_len + j]``. Positions past the end keep the
+    drafter's token. The target still verifies every token.
+
+SGLANG_REPAIR_POLICY=fresh|recycle|keep, SGLANG_REPAIR_MAX_PASSES=<r>
+    Choose the next block's draft tokens after a rejection. ``recycle`` uses the
+    target's own predictions after the first mismatch (a Jacobi step);
+    ``keep`` keeps the previous draft's tokens after the corrected one. Both
+    fall back to the fresh DFlash draft where no such token exists, and after
+    ``r`` consecutive repaired blocks. Only target-verified tokens are committed.
+
+SGLANG_REPAIR_SWEEPS=<k>
+    Probe mode: on every block, run k extra full target passes that iterate the
+    Jacobi map y'_j = argmax F(y_{<j}) ("recycle" sweeps) and k passes that only
+    correct the first mismatch ("keep" sweeps), record each pass's accepted
+    length, then re-run the pass on the original draft and commit it, so the
+    decoding trajectory is the plain DFlash one. Implies a trace (it syncs), so
+    no timing from probe runs.
+
+SGLANG_REPAIR_TRACE=<path>
+    Append one JSON line per request per cycle: prefix length, the fresh draft,
+    the verified candidate, the target argmax at every block position, the
+    accepted length and any probe sweeps. Syncs the host every cycle.
+"""
+
+from __future__ import annotations
+
+import collections
+import json
+import logging
+import os
+from typing import Dict, List, Optional
+
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+def _env(name: str) -> Optional[str]:
+    value = os.environ.get(name)
+    return value if value else None
+
+
+class CycleTimer:
+    """Per-cycle GPU phase times from CUDA events, resolved without host syncs."""
+
+    _RING = 256
+
+    def __init__(self, path: str):
+        self._file = open(path, "a", buffering=1)
+        self._pending: collections.deque = collections.deque()
+        self._origin = torch.cuda.Event(enable_timing=True)
+        self._origin.record()
+        self._cur: Optional[dict] = None
+        self._ring: List[torch.Tensor] = []
+        self._ring_pos = 0
+        self._file.write(
+            json.dumps({"event": "timer_start", "pid": os.getpid()}) + "\n"
+        )
+
+    def _event(self) -> torch.cuda.Event:
+        ev = torch.cuda.Event(enable_timing=True)
+        ev.record()
+        return ev
+
+    def begin(self, bs: int, seq_lens_cpu: Optional[torch.Tensor], block: int) -> None:
+        seq = None
+        if seq_lens_cpu is not None:
+            seq = [int(x) for x in seq_lens_cpu[:bs].tolist()]
+        self._cur = {
+            "bs": bs,
+            "block": block,
+            "seq": seq,
+            "ev": [("start", self._event())],
+        }
+
+    def mark(self, name: str) -> None:
+        if self._cur is not None:
+            self._cur["ev"].append((name, self._event()))
+
+    def end(self, commit_lens: torch.Tensor) -> None:
+        cur = self._cur
+        if cur is None:
+            return
+        self._cur = None
+        n = commit_lens.numel()
+        if len(self._ring) < self._RING:
+            buf = torch.empty(max(n, 64), dtype=torch.int64, pin_memory=True)
+            self._ring.append(buf)
+        else:
+            buf = self._ring[self._ring_pos % self._RING]
+            if buf.numel() < n:
+                buf = torch.empty(n, dtype=torch.int64, pin_memory=True)
+                self._ring[self._ring_pos % self._RING] = buf
+        self._ring_pos += 1
+        buf[:n].copy_(commit_lens.to(torch.int64), non_blocking=True)
+        cur["commit_buf"] = (buf, n)
+        cur["ev"].append(("append", self._event()))
+        self._pending.append(cur)
+        self._drain(block=False)
+
+    def _drain(self, block: bool) -> None:
+        # The ring holds at most _RING outstanding copies; force the oldest out
+        # before its pinned buffer could be reused.
+        while self._pending:
+            rec = self._pending[0]
+            last = rec["ev"][-1][1]
+            must = block or len(self._pending) >= self._RING - 1
+            if not must and not last.query():
+                break
+            last.synchronize()
+            self._pending.popleft()
+            events = rec["ev"]
+            out: Dict[str, object] = {
+                "t0_ms": self._origin.elapsed_time(events[0][1]),
+                "bs": rec["bs"],
+                "block": rec["block"],
+                "seq": rec["seq"],
+            }
+            buf, n = rec["commit_buf"]
+            out["commit"] = buf[:n].tolist()
+            prev = events[0][1]
+            for name, ev in events[1:]:
+                out[name + "_us"] = round(prev.elapsed_time(ev) * 1000.0, 2)
+                prev = ev
+            self._file.write(json.dumps(out) + "\n")
+
+    def close(self) -> None:
+        self._drain(block=True)
+        self._file.close()
+
+
+class OracleInjector:
+    """Replace draft tokens with a reference continuation keyed by prompt ids."""
+
+    def __init__(self, path: str, device: torch.device, num_slots: int):
+        with open(path) as f:
+            data = json.load(f)
+        self._table: Dict[tuple, List[int]] = {}
+        for ref in data["refs"]:
+            ids = [int(x) for x in ref["input_ids"]]
+            self._table[tuple(ids)] = ids + [int(x) for x in ref["continuation"]]
+        self._max_len = max((len(v) for v in self._table.values()), default=1)
+        self._buf = torch.zeros(
+            (num_slots, self._max_len), dtype=torch.int64, device=device
+        )
+        self._lens = torch.zeros((num_slots,), dtype=torch.int64, device=device)
+        self.hits = 0
+        self.misses = 0
+        logger.info(
+            "repair oracle: %d reference continuations from %s", len(self._table), path
+        )
+
+    def register(self, reqs, req_pool_indices: torch.Tensor) -> None:
+        slots = req_pool_indices.tolist()
+        for req, slot in zip(reqs, slots):
+            full = self._table.get(tuple(int(x) for x in req.origin_input_ids))
+            if full is None:
+                self.misses += 1
+                self._lens[slot] = 0
+                continue
+            self.hits += 1
+            self._buf[slot, : len(full)] = torch.tensor(full, dtype=torch.int64)
+            self._lens[slot] = len(full)
+
+    def inject(
+        self,
+        draft_tokens: torch.Tensor,
+        seq_lens: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+    ) -> None:
+        bs, block = draft_tokens.shape
+        offs = torch.arange(1, block, device=draft_tokens.device, dtype=torch.int64)
+        pos = seq_lens.to(torch.int64).unsqueeze(1) + offs.unsqueeze(0)
+        slots = req_pool_indices.to(torch.int64)
+        valid = pos < self._lens[slots].unsqueeze(1)
+        vals = self._buf[slots].gather(1, pos.clamp(max=self._max_len - 1))
+        draft_tokens[:, 1:] = torch.where(valid, vals, draft_tokens[:, 1:])
+
+
+class RepairPolicy:
+    """Next-block drafts from the previous verify pass (Jacobi recycling)."""
+
+    def __init__(
+        self,
+        mode: str,
+        max_passes: int,
+        device: torch.device,
+        num_slots: int,
+        block: int,
+    ):
+        if mode not in ("fresh", "recycle", "keep"):
+            raise ValueError(
+                f"SGLANG_REPAIR_POLICY must be fresh, recycle or keep, got {mode!r}"
+            )
+        self.mode = mode
+        self.max_passes = max_passes
+        self.block = block
+        self._prev_y = torch.zeros((num_slots, block), dtype=torch.int64, device=device)
+        self._prev_t = torch.zeros((num_slots, block), dtype=torch.int64, device=device)
+        self._prev_a = torch.full((num_slots,), -1, dtype=torch.int64, device=device)
+        self._streak = torch.zeros((num_slots,), dtype=torch.int64, device=device)
+        self._offs = torch.arange(1, block, device=device, dtype=torch.int64)
+        self._last_used: Optional[torch.Tensor] = None
+
+    def reset(self, req_pool_indices: torch.Tensor) -> None:
+        slots = req_pool_indices.to(torch.int64)
+        self._prev_a[slots] = -1
+        self._streak[slots] = 0
+
+    def apply(
+        self, draft_tokens: torch.Tensor, req_pool_indices: torch.Tensor
+    ) -> torch.Tensor:
+        """Overwrite draft_tokens[:, 1:] in place; return a per-position source mask."""
+        slots = req_pool_indices.to(torch.int64)
+        a = self._prev_a[slots].unsqueeze(1)
+        if self.mode == "recycle":
+            src = a + self._offs.unsqueeze(0)
+            table = self._prev_t[slots]
+        else:
+            src = a + 1 + self._offs.unsqueeze(0)
+            table = self._prev_y[slots]
+        allowed = (a >= 0) & (self._streak[slots].unsqueeze(1) < self.max_passes)
+        valid = allowed & (src <= self.block - 1)
+        vals = table.gather(1, src.clamp(min=0, max=self.block - 1))
+        draft_tokens[:, 1:] = torch.where(valid, vals, draft_tokens[:, 1:])
+        self._last_used = valid.any(dim=1)
+        return valid
+
+    def record(
+        self,
+        candidates: torch.Tensor,
+        target_predict: torch.Tensor,
+        accept_len: torch.Tensor,
+        req_pool_indices: torch.Tensor,
+    ) -> None:
+        slots = req_pool_indices.to(torch.int64)
+        self._prev_y[slots] = candidates.to(torch.int64)
+        self._prev_t[slots] = target_predict.to(torch.int64)
+        a = accept_len.to(torch.int64)
+        # A fully accepted block leaves nothing to repair.
+        self._prev_a[slots] = torch.where(
+            a >= self.block - 1, torch.full_like(a, -1), a
+        )
+        used = self._last_used
+        if used is None:
+            used = torch.zeros_like(a, dtype=torch.bool)
+        self._streak[slots] = torch.where(
+            used, self._streak[slots] + 1, torch.zeros_like(a)
+        )
+        self._last_used = None
+
+
+class TraceWriter:
+    def __init__(self, path: str):
+        self._file = open(path, "a", buffering=1)
+
+    def write(self, record: dict) -> None:
+        self._file.write(json.dumps(record) + "\n")
+
+
+class RepairProbe:
+    """Container the DFlash worker consults; every member is None when unused."""
+
+    def __init__(self, device: torch.device, num_slots: int, block: int):
+        timing = _env("SGLANG_REPAIR_TIMING_LOG")
+        oracle = _env("SGLANG_REPAIR_ORACLE")
+        policy = _env("SGLANG_REPAIR_POLICY")
+        trace = _env("SGLANG_REPAIR_TRACE")
+        sweeps = int(os.environ.get("SGLANG_REPAIR_SWEEPS", "0") or 0)
+        self.timer = CycleTimer(timing) if timing else None
+        self.oracle = OracleInjector(oracle, device, num_slots) if oracle else None
+        self.policy = None
+        if policy and policy != "fresh":
+            max_passes = int(os.environ.get("SGLANG_REPAIR_MAX_PASSES", "1000000"))
+            self.policy = RepairPolicy(policy, max_passes, device, num_slots, block)
+        self.sweeps = sweeps
+        self.trace = TraceWriter(trace) if trace else None
+        if self.sweeps > 0 and self.trace is None:
+            raise ValueError("SGLANG_REPAIR_SWEEPS needs SGLANG_REPAIR_TRACE")
+        self.enabled = any(
+            x is not None for x in (self.timer, self.oracle, self.policy, self.trace)
+        )
+        if self.enabled:
+            logger.warning(
+                "repair probe on: timing=%s oracle=%s policy=%s sweeps=%d trace=%s",
+                timing,
+                oracle,
+                policy,
+                sweeps,
+                trace,
+            )
+
+    def on_prefill(self, batch) -> None:
+        if self.oracle is not None:
+            self.oracle.register(batch.reqs, batch.req_pool_indices)
+        if self.policy is not None:
+            self.policy.reset(batch.req_pool_indices)
