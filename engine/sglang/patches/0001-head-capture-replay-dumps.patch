+    def _head_capture_plain(self, batch, forward_batch, batch_result) -> None:
+        """Capture-only: record plain-decode head inputs and the sampled tokens."""
+        mode = forward_batch.forward_mode
+        if not (mode.is_decode() or mode.is_extend()):
+            return
+        bs = len(batch.reqs)
+        hidden = head_capture.take_head_input(mode.name, bs)
+        if hidden is None:
+            return
+        logits = batch_result.logits_output.next_token_logits
+        record = head_capture.batch_meta(batch.reqs, forward_batch.seq_lens)
+        record.update(
+            forward_mode=mode.name,
+            hidden=head_capture.bf16_bits(hidden),
+            next_token_ids=batch_result.next_token_ids.detach().cpu().numpy(),
+            engine_argmax=torch.argmax(logits, dim=-1).cpu().numpy(),
+            engine_top2=head_capture.top2(logits),
+            output_lens=np.asarray([len(r.output_ids) for r in batch.reqs], np.int64),
+        )
+        head_capture.write("plain_decode", record)
