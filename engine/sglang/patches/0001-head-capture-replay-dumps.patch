index 0000000000..ee91c0bee5
--- /dev/null
+++ b/python/sglang/srt/debug_utils/head_capture.py
@@ -0,0 +1,113 @@
+"""Capture-only instrumentation: record the exact LM-head inputs for offline replay.
+
+Disabled unless ``SGLANG_HEAD_CAPTURE_DIR`` is set. When enabled, ``LogitsProcessor``
+stashes the tensor it passes to the head (``pruned_states``), and the speculative and
+plain decode workers append one pickled record per forward step to
+``$SGLANG_HEAD_CAPTURE_DIR/<kind>_<pid>.pkl``. Hidden vectors are stored as raw BF16
+bits (``uint16``) so that the offline analysis sees exactly the values the head read.
+
+The stash is plain Python state, so CUDA graph replay would leave it stale: run the
+server with ``--disable-cuda-graph`` and ``--disable-overlap-schedule``. The hooks
+refuse to write a record whose stashed tensor has the wrong forward mode or row count.
+
+This module is for measurement only; it adds device-to-host copies and is not meant
+for serving.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import pickle
+import time
+from typing import Any, Dict, List, Optional
+
+import numpy as np
+import torch
+
+logger = logging.getLogger(__name__)
+
+_DIR = os.environ.get("SGLANG_HEAD_CAPTURE_DIR")
+_stash: Optional[torch.Tensor] = None
+_stash_mode: Optional[str] = None
+_files: Dict[str, Any] = {}
+_counts: Dict[str, int] = {}
+_skipped: Dict[str, int] = {}
+
+
+def enabled() -> bool:
+    return _DIR is not None
+
+
+def stash_head_input(hidden: torch.Tensor, forward_mode: Any) -> None:
+    """Called by LogitsProcessor with the exact tensor handed to the LM head."""
+    global _stash, _stash_mode
+    _stash = hidden
+    _stash_mode = getattr(forward_mode, "name", str(forward_mode))
+
+
+def take_head_input(
+    expect_mode: Optional[str], expect_rows: int
+) -> Optional[torch.Tensor]:
+    """Return and clear the stash if it matches the expected mode and row count.
+
+    ``expect_mode=None`` accepts any forward mode (the draft decode steps).
+    """
+    global _stash, _stash_mode
+    hidden, mode = _stash, _stash_mode
+    _stash, _stash_mode = None, None
+    if (
+        hidden is None
+        or (expect_mode is not None and mode != expect_mode)
+        or hidden.shape[0] != expect_rows
+    ):
+        key = str(expect_mode)
+        _skipped[key] = _skipped.get(key, 0) + 1
+        if _skipped[key] <= 5:
+            logger.warning(
+                "head_capture: stash mismatch (have %s rows=%s, want %s rows=%d)",
+                mode,
+                None if hidden is None else tuple(hidden.shape),
+                expect_mode,
+                expect_rows,
+            )
+        return None
+    return hidden
+
+
+def bf16_bits(t: torch.Tensor) -> np.ndarray:
+    """BF16 tensor -> uint16 numpy array holding the exact bit patterns."""
+    if t.dtype != torch.bfloat16:
+        raise TypeError(f"head_capture expects BF16 head inputs, got {t.dtype}")
+    return t.detach().contiguous().view(torch.int16).cpu().numpy().view(np.uint16)
+
+
+def top2(logits: torch.Tensor) -> np.ndarray:
+    """Engine logits -> [rows, 2] float32 (best, second-best) values."""
+    vals = torch.topk(logits.float(), 2, dim=-1).values
+    return vals.cpu().numpy().astype(np.float32)
+
+
+def write(kind: str, record: Dict[str, Any]) -> None:
+    """Append one record; files are flushed per record so a killed server loses none."""
+    f = _files.get(kind)
+    if f is None:
+        os.makedirs(_DIR, exist_ok=True)
+        path = os.path.join(_DIR, f"{kind}_{os.getpid()}.pkl")
+        f = open(path, "ab")
+        _files[kind] = f
+        logger.info("head_capture: writing %s records to %s", kind, path)
+    record["kind"] = kind
+    record["step"] = _counts.get(kind, 0)
+    record["wall_time"] = time.time()
+    pickle.dump(record, f, protocol=pickle.HIGHEST_PROTOCOL)
+    f.flush()
+    _counts[kind] = record["step"] + 1
+
+
+def batch_meta(reqs: List[Any], seq_lens: torch.Tensor) -> Dict[str, Any]:
+    return {
+        "rids": [str(r.rid) for r in reqs],
+        "prompt_lens": np.asarray([len(r.origin_input_ids) for r in reqs], np.int64),
+        "seq_lens": seq_lens.detach().cpu().numpy().astype(np.int64),
+    }
