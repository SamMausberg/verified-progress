+    def _head_capture_verify(self, batch, seq_lens, verify_input, batch_output):
+        """Capture-only: one record per verify step with aligned head inputs.
+
+        Row k of draft_hidden produced draft token k+1 (draft_tokens[:, k+1]); row j
+        of target_hidden is the head input at verify position j, whose argmax is
+        compared with draft token j+1.
+        """
+        bs = len(batch.reqs)
+        width = self.speculative_num_draft_tokens
+        target = head_capture.take_head_input("TARGET_VERIFY", bs * width)
+        drafts = getattr(self.draft_worker, "head_capture_draft_hidden", None)
+        self.draft_worker.head_capture_draft_hidden = None
+        if (
+            self.topk != 1
+            or target is None
+            or not drafts
+            or any(h is None or h.shape[0] != bs for h in drafts)
+        ):
+            return
+        logits = batch_output.logits_output.next_token_logits
+        record = head_capture.batch_meta(batch.reqs, seq_lens)
+        record.update(
+            draft_tokens=verify_input.draft_token.view(bs, width).cpu().numpy(),
+            draft_hidden=head_capture.bf16_bits(torch.stack(drafts, dim=1)),
+            target_hidden=head_capture.bf16_bits(target.view(bs, width, -1)),
+            target_argmax=torch.argmax(logits, dim=-1).view(bs, width).cpu().numpy(),
+            target_top2=head_capture.top2(logits).reshape(bs, width, 2),
+            accept_lens=batch_output.accept_lens.cpu().numpy(),
+        )
+        head_capture.write("mtp_verify", record)
+
