+    def _head_capture_verify(
+        self,
+        *,
+        batch,
+        prefix_lens,
+        draft_hidden,
+        draft_tokens,
+        logits,
+        accept_len,
+        commit_lens,
+    ) -> None:
+        """Capture-only: one record per verify step with aligned head inputs.
+
+        draft_hidden[:, k] (k >= 1) is the head input that proposed draft_tokens[:, k];
+        target_hidden[:, j] is the verify head input whose argmax is compared with
+        draft_tokens[:, j + 1].
+        """
+        bs = len(batch.reqs)
+        block = int(self.block_size)
+        target = head_capture.take_head_input("TARGET_VERIFY", bs * block)
+        if (
+            target is None
+            or draft_hidden is None
+            or draft_hidden.shape[0] != bs * block
+        ):
+            return
+        record = head_capture.batch_meta(batch.reqs, prefix_lens)
+        record.update(
+            draft_tokens=draft_tokens.detach().cpu().numpy().copy(),
+            draft_hidden=head_capture.bf16_bits(
+                draft_hidden.view(bs, block, -1)[:, 1:, :]
+            ),
+            target_hidden=head_capture.bf16_bits(target.view(bs, block, -1)),
+            target_argmax=torch.argmax(logits, dim=-1).view(bs, block).cpu().numpy(),
+            target_top2=head_capture.top2(logits).reshape(bs, block, 2),
+            accept_lens=commit_lens.detach().cpu().numpy(),
+            num_correct_drafts=accept_len.detach().cpu().numpy(),
+        )
+        head_capture.write("dflash_verify", record)
