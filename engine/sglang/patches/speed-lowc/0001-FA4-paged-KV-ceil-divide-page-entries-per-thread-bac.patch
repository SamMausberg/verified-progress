From 8362d9727acead2babc9419120633017ced50c1f Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Fri, 2 Oct 2026 17:37:34 +0000
Subject: [PATCH 1/3] FA4 paged KV: ceil-divide page entries per thread
 (backport flash-attention #2745)

On sm_90 the head-dim-256 forward tile is 128 x 80, so the non-TMA paged
loader computed 80 // 128 = 0 page-table entries per thread and failed to
compile. Upstream flash-attention fixed this in #2745.
---
 .../sglang/kernels/ops/attention/flash_attn/cute/paged_kv.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/python/sglang/kernels/ops/attention/flash_attn/cute/paged_kv.py b/python/sglang/kernels/ops/attention/flash_attn/cute/paged_kv.py
index 9b24a4268b..07acc4a766 100644
--- a/python/sglang/kernels/ops/attention/flash_attn/cute/paged_kv.py
+++ b/python/sglang/kernels/ops/attention/flash_attn/cute/paged_kv.py
@@ -93,7 +93,10 @@ class PagedKVManager(ParamsBase):
             atom_async_copy, thr_layout, val_layout
         )
         gmem_thr_copy_KV = gmem_tiled_copy_KV.get_slice(thread_idx)
-        page_entry_per_thread = n_block_size // num_threads
+        # Include the final partially populated wave of rows (upstream
+        # Dao-AILab/flash-attention #2745): the SM90 head-dim-256 tile has
+        # n_block_size 80 < 128 threads, which otherwise gives zero entries.
+        page_entry_per_thread = (n_block_size + num_threads - 1) // num_threads
 
         if const_expr(mSFK_paged is not None or mSFV_paged is not None):
             atom_async_copy_sf = cute.make_copy_atom(
