@@ -49,15 +53,17 @@ logger = logging.getLogger(__name__)
 
 VERIFY_PLAN = envs.SGLANG_HOSTGAP_VERIFY_PLAN.get()
 DRAFT_INDPTR = envs.SGLANG_HOSTGAP_DRAFT_INDPTR.get()
+DFLASH_DRAFT_PLAN = envs.SGLANG_HOSTGAP_DFLASH_DRAFT_PLAN.get()
 VALIDATE = envs.SGLANG_HOSTGAP_VALIDATE.get()
 # The guard is required whenever a hostgap flag removes a blocking read.
-GUARD = VERIFY_PLAN or DRAFT_INDPTR
+GUARD = VERIFY_PLAN or DRAFT_INDPTR or DFLASH_DRAFT_PLAN
 
-if VERIFY_PLAN or DRAFT_INDPTR or VALIDATE:
+if GUARD or VALIDATE:
     logger.info(
-        "hostgap: verify_plan=%s draft_indptr=%s validate=%s",
+        "hostgap: verify_plan=%s draft_indptr=%s dflash_draft_plan=%s validate=%s",
         VERIFY_PLAN,
         DRAFT_INDPTR,
+        DFLASH_DRAFT_PLAN,
         VALIDATE,
     )
 
@@ -309,6 +315,31 @@ def eagle_verify_plan_kwargs(
     )
 
 
+def block_verify_plan_kwargs(
+    paged_kernel_lens_host: torch.Tensor, draft_token_num: int
+) -> dict:
+    """Host-known plan inputs for a DFlash block forward without a custom mask.
+
+    ``DFlashVerifyInput.generate_attn_arg_prefill`` (no ragged layout) builds
+    qo_indptr as a stride of ``draft_token_num`` and kv lengths as the
+    wrapper's paged lengths plus ``draft_token_num`` (page size 1).
+    """
+    bs = paged_kernel_lens_host.numel()
+    kv_lens = paged_kernel_lens_host.to(torch.int32) + draft_token_num
+    kv_indptr = torch.zeros(bs + 1, dtype=torch.int32)
+    kv_indptr[1:] = torch.cumsum(kv_lens, dim=0)
+    qo_indptr = torch.arange(
+        0, (bs + 1) * draft_token_num, step=draft_token_num, dtype=torch.int32
+    )
+    return dict(
+        qo_indptr_host=qo_indptr,
+        kv_indptr_host=kv_indptr,
+        kv_lens_host=kv_lens,
+        max_q_len=draft_token_num,
+        max_kv_len=int(kv_lens.max()),
+    )
+
+
 def draft_kv_indptr_host(
     seq_lens_cpu: torch.Tensor,
     num_seqs: int,
