+def _stage(wrapper, attr: str, values) -> torch.Tensor:
+    """Copy host values into a per-wrapper pinned int32 buffer (H2D never syncs).
+
+    Reuse of the buffer is ordered after its previous copy by PlanGuard.
+    """
+    values = np.asarray(values, dtype=np.int32)
+    buf = getattr(wrapper, attr, None)
+    n = values.size
+    if buf is None or buf.numel() < n:
+        buf = torch.empty(max(n, 1024), dtype=torch.int32).pin_memory()
+        setattr(wrapper, attr, buf)
+    buf.numpy()[:n] = values
+    return buf[:n]
 
 
