--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -1364,10 +1364,11 @@ class Envs:
     # ===================================================================
     SGLANG_ENABLE_OVERLAP_PLAN_STREAM = EnvBool(False)
     # hostgap (srt/layers/attention/flashinfer_hostgap.py): plan FlashInfer's
-    # EAGLE target verify from host-known lengths instead of blocking
-    # device-to-host reads; VALIDATE also runs the stock reads and raises on any
-    # difference (synchronizes; correctness runs only).
+    # EAGLE target verify and the multi-step draft from host-known lengths
+    # instead of blocking device-to-host reads; VALIDATE also runs the stock
+    # reads and raises on any difference (synchronizes; correctness runs only).
     SGLANG_HOSTGAP_VERIFY_PLAN = EnvBool(False)
+    SGLANG_HOSTGAP_DRAFT_INDPTR = EnvBool(False)
     SGLANG_HOSTGAP_VALIDATE = EnvBool(False)
     # Experimental: allow pipeline parallelism x speculative decoding
     # (EAGLE/MTP). Off by default; see the PP+spec RFC for constraints
