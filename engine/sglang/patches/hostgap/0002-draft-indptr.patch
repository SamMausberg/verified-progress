+        VERIFY_PLAN,
+        DRAFT_INDPTR,
+        VALIDATE,
+    )
 
 
 class PlanGuard:
@@ -302,6 +309,38 @@ def eagle_verify_plan_kwargs(
     )
 
 
+def draft_kv_indptr_host(
+    seq_lens_cpu: torch.Tensor,
+    num_seqs: int,
+    num_padding: int,
+    topk: int,
+    num_steps: int,
+    window_cap: int,
+) -> torch.Tensor:
+    """Host copy of ``generate_draft_decode_kv_indices``'s ``kv_indptr`` rows.
+
+    The Triton kernel writes, for step ``i`` and row ``z`` of the
+    ``num_seqs * topk`` draft rows, ``sum(positions[:z]) + z * (i + 1)``, where
+    the draft positions are each request's committed length repeated ``topk``
+    times (``prepare_for_draft``) and zero on CUDA-graph padding rows
+    (``EAGLEDraftCudaGraphRunner.execute``); with a draft window the positions
+    are capped at ``window + sink``. Returns int32 of shape
+    ``(num_steps, num_seqs * topk + 1)``.
+    """
+    raw = num_seqs - num_padding
+    positions = torch.zeros(num_seqs * topk, dtype=torch.int64)
+    positions[: raw * topk] = seq_lens_cpu[:raw].to(torch.int64).repeat_interleave(topk)
+    if window_cap > 0:
+        positions = torch.clamp(positions, max=window_cap)
+    rows = num_seqs * topk
+    out = torch.zeros((num_steps, rows + 1), dtype=torch.int64)
+    cum = torch.cumsum(positions, dim=0)
+    z = torch.arange(1, rows + 1, dtype=torch.int64)
+    for i in range(num_steps):
+        out[i, 1:] = cum + z * (i + 1)
+    return out.to(torch.int32)
+
+
 def check_equal(name: str, expected: torch.Tensor, actual: torch.Tensor) -> None:
     if expected.shape != actual.shape or not torch.equal(expected.cpu(), actual.cpu()):
         raise AssertionError(
@@ -335,15 +374,17 @@ def _verify_plan_state(wrapper, host_kwargs: dict) -> dict:
 
 class ValidationStats:
     verify_plans = 0
+    draft_indptrs = 0
 
     @classmethod
     def log(cls) -> None:
-        total = cls.verify_plans
+        total = cls.verify_plans + cls.draft_indptrs
         if total and (total & (total - 1)) == 0:
             logger.info(
-                "hostgap validation: %d verify plans matched the stock path; "
-                "plan guard waited %d of %d times",
+                "hostgap validation: %d verify plans and %d draft kv_indptr sets "
+                "matched the stock path; plan guard waited %d of %d times",
                 cls.verify_plans,
+                cls.draft_indptrs,
                 PlanGuard.waits,
                 PlanGuard.calls,
             )
