 blocking reads guaranteed that the previous copy had executed before the next
@@ -47,12 +48,18 @@ from sglang.srt.environ import envs
 logger = logging.getLogger(__name__)
 
 VERIFY_PLAN = envs.SGLANG_HOSTGAP_VERIFY_PLAN.get()
+DRAFT_INDPTR = envs.SGLANG_HOSTGAP_DRAFT_INDPTR.get()
 VALIDATE = envs.SGLANG_HOSTGAP_VALIDATE.get()
 # The guard is required whenever a hostgap flag removes a blocking read.
-GUARD = VERIFY_PLAN
-
-if VERIFY_PLAN or VALIDATE:
-    logger.info("hostgap: verify_plan=%s validate=%s", VERIFY_PLAN, VALIDATE)
+GUARD = VERIFY_PLAN or DRAFT_INDPTR
