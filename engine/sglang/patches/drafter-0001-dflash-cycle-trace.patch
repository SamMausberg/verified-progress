 from sglang.srt.speculative.dflash_info_v2 import DFlashDraftInputV2
@@ -2807,6 +2808,14 @@ class DFlashWorkerV2(BaseSpecWorker):
             prefix_lens=prefix_lens,
             bs=bs,
         )
+        if dflash_trace.TRACER is not None and target_predict is not None:
+            dflash_trace.TRACER.record(
