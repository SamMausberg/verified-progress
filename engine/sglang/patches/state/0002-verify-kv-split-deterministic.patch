From 5f18d65fbd7ce971acb3dd143a0e7c8ea181d367 Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <sam@findtensor.com>
Date: Wed, 30 Sep 2026 19:28:54 +0000
Subject: [PATCH 2/2] Pin the FlashInfer target-verify KV split under
 deterministic inference

Decode and extend already pass the deterministic split settings to the
FlashInfer planner; target verify did not, so the planner chose the KV
split from the batch and verify logits depended on batch composition.
Pass prefill_split_tile_size (None unless deterministic inference is on)
in both the eager and the CUDA-graph verify paths.
---
 python/sglang/srt/layers/attention/flashinfer_backend.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/python/sglang/srt/layers/attention/flashinfer_backend.py b/python/sglang/srt/layers/attention/flashinfer_backend.py
index e4d318207c..d5403d29f9 100644
--- a/python/sglang/srt/layers/attention/flashinfer_backend.py
+++ b/python/sglang/srt/layers/attention/flashinfer_backend.py
@@ -761,6 +761,10 @@ class FlashInferAttnBackend(AttentionBackend):
                 use_ragged=False,
                 encoder_lens=encoder_lens[:bs] if encoder_lens is not None else None,
                 spec_info=spec_info,
+                # Deterministic inference: a batch-independent KV split, as
+                # for extend; otherwise the planner picks the split from the
+                # batch and verify logits change with batch composition.
+                fixed_split_size=self.prefill_split_tile_size,
             )
         elif forward_mode.is_dllm_extend():
             self.indices_updater_prefill.update(
@@ -985,6 +989,7 @@ class FlashInferAttnBackend(AttentionBackend):
                 use_ragged=False,
                 encoder_lens=forward_batch.encoder_lens,
                 spec_info=forward_batch.spec_info,
+                fixed_split_size=self.prefill_split_tile_size,
             )
             self.forward_metadata = PrefillMetadata(
                 self.prefill_wrappers_verify,
