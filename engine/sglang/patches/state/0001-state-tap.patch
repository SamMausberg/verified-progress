@@ -0,0 +1,371 @@
+"""Bit-exact tensor tap for locating where two serving configurations diverge.
+
+Enabled with SGLANG_STATE_TAP_DIR. Forward hooks on the target model's modules
+write, for every row of every forward, a 64-bit hash of each module output's
+exact bits into a static device buffer. Because the hooks only launch GPU ops
+into static buffers, they are captured into CUDA graphs and replayed with them;
+the rest of the forward is unchanged (the hooks only read module outputs).
+
+After each target-model forward that contains a request whose rid starts with
+SGLANG_STATE_TAP_RID_PREFIX (default "tap-"), the rows of that request are
+copied to the host and saved: per-module hashes, input token ids and positions,
+the head input (final norm output), and the logits fed to argmax (full rows
+where the top-2 gap is at most SGLANG_STATE_TAP_FULL_GAP, top-16 otherwise).
+Two runs of the same prompt can then be compared position by position and
+module by module; slots are numbered in first-execution order, which follows
+the model's layer order, so the lowest differing slot at the earliest
+differing position names the first op whose output bits differ. Row counts
+are reset before every forward, so a slot the forward did not write reads 0.
+
+Diagnostic only: the host copies synchronize the forward stream.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+from pathlib import Path
+from typing import Any, Dict, List, Optional
+
+import numpy as np
+import torch
+
+logger = logging.getLogger(__name__)
+
+_MAX_ROWS = 8192 + 256
+_MAX_COLS = 262144
+
+
+def _enabled() -> bool:
+    return bool(os.environ.get("SGLANG_STATE_TAP_DIR"))
+
+
+class StateTap:
+    def __init__(self, model: torch.nn.Module, device: torch.device):
+        self.dir = Path(os.environ["SGLANG_STATE_TAP_DIR"])
+        self.dir.mkdir(parents=True, exist_ok=True)
+        self.prefix = os.environ.get("SGLANG_STATE_TAP_RID_PREFIX", "tap-")
+        self.full_gap = float(os.environ.get("SGLANG_STATE_TAP_FULL_GAP", "0.5"))
+        # Positive control: add one unit in the last place to the first element
+        # of this module's output in every forward, before it is hashed and
+        # consumed downstream. The tap must name this module as the first
+        # difference against an unperturbed run.
+        self.perturb = os.environ.get("SGLANG_STATE_TAP_PERTURB") or None
+        gen = torch.Generator(device="cpu").manual_seed(0x5EED)
+        # Odd random multipliers: sum(bits_i * c_i) mod 2**64 as the row hash.
+        self.coeff = (
+            torch.randint(1, 2**62, (_MAX_COLS,), generator=gen, dtype=torch.int64) * 2
+            + 1
+        ).to(device)
+        self.names: List[str] = []
+        self.slot_of: Dict[str, int] = {}
+        for name, module in model.named_modules():
+            if not name or "visual" in name or ".mtp" in name:
+                continue
+            module.register_forward_hook(self._make_hook(name))
+        # Slots are assigned on first call; allocate generously.
+        self.max_slots = 4 * sum(1 for _ in model.named_modules())
+        self.hashes = torch.zeros(
+            (self.max_slots, _MAX_ROWS), dtype=torch.int64, device=device
+        )
+        self.rows = torch.zeros((self.max_slots,), dtype=torch.int64, device=device)
+        self.head_in: Optional[torch.Tensor] = None
+        self.head_in_name: Optional[str] = None
+        self._mode = "unknown"
+        self._names_written = 0
+        self._tokens: Optional[int] = None
+        self._tokens_real: Optional[int] = None
+        self._cache: Dict[int, Dict[str, Any]] = {}
+        self.forward_count = 0
+        logger.info("state tap enabled: dir=%s prefix=%s", self.dir, self.prefix)
+
+    # ------------------------------------------------------------ hooks
+    def _slot(self, key: str) -> int:
+        slot = self.slot_of.get(key)
+        if slot is None:
+            slot = len(self.names)
+            assert slot < self.max_slots, "state tap: too many slots"
+            self.names.append(key)
+            self.slot_of[key] = slot
+        return slot
+
+    def _row_hash(self, flat: torch.Tensor) -> torch.Tensor:
+        """64-bit hash of the exact bits of every row of a 2-D tensor."""
+        if flat.dtype in (torch.bfloat16, torch.float16):
+            bits = flat.contiguous().view(torch.int16).to(torch.int64)
+        elif flat.dtype == torch.float32:
+            bits = flat.contiguous().view(torch.int32).to(torch.int64)
+        else:
+            bits = flat.to(torch.int64)
+        rows, m = bits.shape
+        if m <= _MAX_COLS:
+            return (bits * self.coeff[:m]).sum(dim=-1)
+        # Longer rows (a layer's SSM state): hash fixed-size chunks, then combine
+        # the chunk hashes with a second set of coefficients.
+        pad = (-m) % _MAX_COLS
+        if pad:
+            bits = torch.nn.functional.pad(bits, (0, pad))
+        chunks = bits.reshape(rows, -1, _MAX_COLS)
+        per_chunk = (chunks * self.coeff).sum(dim=-1)
+        return (per_chunk * self.coeff[: per_chunk.shape[1]]).sum(dim=-1)
+
+    def _cache_hashes(
+        self, forward_batch, runner, i: int, first_row: int
+    ) -> Dict[str, Any]:
+        """Hash the cache state request i reads in this forward, before it runs.
+
+        KV: one hash per cached position and attention layer, gathered through the
+        request's req_to_token row (so a repointed row shows up). GDN: one hash of
+        the request's convolution window and SSM state per linear-attention layer.
+        """
+        pool = runner.req_to_token_pool
+        kv = runner.token_to_kv_pool
+        cached = int(forward_batch.positions[first_row].item())
+        rp = int(forward_batch.req_pool_indices[i].item())
+        attn_ids = sorted(getattr(kv, "full_attention_layer_id_mapping", {}))
+        n_layers = runner.model_config.num_hidden_layers
+        out: Dict[str, Any] = {"cache_positions": cached, "cache_attn_layers": attn_ids}
+        idx = pool.req_to_token[rp, :cached].to(torch.int64)
+        ks, vs = [], []
+        for layer in attn_ids:
+            if cached == 0:
+                empty = torch.zeros(0, dtype=torch.int64, device=idx.device)
+                ks.append(empty)
+                vs.append(empty)
+                continue
+            k = kv.get_key_buffer(layer)[idx]
+            v = kv.get_value_buffer(layer)[idx]
+            ks.append(self._row_hash(k.reshape(cached, -1)))
+            vs.append(self._row_hash(v.reshape(cached, -1)))
+        if attn_ids:
+            out["cache_k"] = torch.stack(ks)
+            out["cache_v"] = torch.stack(vs)
+        mapping = getattr(pool, "req_index_to_mamba_index_mapping", None)
+        if mapping is not None:
+            slot = mapping[rp : rp + 1]
+            translate = getattr(pool, "translate_mamba_indices", None)
+            if translate is not None:
+                slot = translate(slot)
+            gdn_ids = [layer for layer in range(n_layers) if layer not in attn_ids]
+            conv, ssm = [], []
+            for layer in gdn_ids:
+                cache = pool.mamba2_layer_cache(layer)
+                conv.append(self._row_hash(cache.conv[0][slot].reshape(1, -1))[0])
+                ssm.append(self._row_hash(cache.temporal[slot].reshape(1, -1))[0])
+            out["cache_gdn_layers"] = gdn_ids
+            out["cache_conv"] = torch.stack(conv)
+            out["cache_ssm"] = torch.stack(ssm)
+        return out
+
+    def _spans(self, forward_batch):
+        fm = forward_batch.forward_mode
+        bs = len(forward_batch.rids or [])
+        if fm.is_target_verify():
+            per = forward_batch.spec_info.draft_token_num
+            spans = [(i * per, (i + 1) * per) for i in range(bs)]
+            return spans, spans
+        if fm.is_decode():
+            spans = [(i, i + 1) for i in range(bs)]
+            return spans, spans
+        if fm.is_extend():
+            lens = forward_batch.extend_seq_lens_cpu
+            starts = [0]
+            for x in lens[:-1]:
+                starts.append(starts[-1] + x)
+            return [(s, s + x) for s, x in zip(starts, lens)], [
+                (i, i + 1) for i in range(bs)
+            ]
+        return None
+
+    def _record(self, key: str, t: torch.Tensor) -> None:
+        if t.dim() == 0 or t.numel() == 0:
+            return
+        if key == self.perturb and t.is_contiguous():
+            first = t.view(-1)[:1]
+            if first.dtype in (torch.bfloat16, torch.float16):
+                first.view(torch.int16).add_(1)
+            elif first.dtype == torch.float32:
+                first.view(torch.int32).add_(1)
+        # One row per token: tensors laid out as [1, T, ...] or [T * heads, ...]
+        # are regrouped with the token count of this forward.
+        # Logits keep their own rows (one per request in a prefill).
+        # Captured graph segments see the padded token count (set by layer 0's
+        # norm during capture); code that runs eagerly, such as attention
+        # backends between the segments of a breakable prefill graph, sees the
+        # real count of this forward.
+        if torch.cuda.is_current_stream_capturing():
+            T = self._tokens
+        else:
+            T = self._tokens_real or self._tokens
+        if key != "logits_processor" and T and t.numel() % T == 0:
+            n = T
+        else:
+            n = t.shape[0]
+        if n > _MAX_ROWS:
+            return
+        flat = t.reshape(n, -1)
+        if flat.shape[1] > _MAX_COLS:
+            return
+        if flat.dtype in (torch.bfloat16, torch.float16):
+            bits = flat.contiguous().view(torch.int16).to(torch.int64)
+        elif flat.dtype == torch.float32:
+            bits = flat.contiguous().view(torch.int32).to(torch.int64)
+        elif flat.dtype == torch.bool:
+            bits = flat.to(torch.int64)
+        elif flat.dtype in (torch.int32, torch.int64, torch.int16, torch.uint8):
+            bits = flat.to(torch.int64)
+        else:
+            return
+        slot = self._slot(key)
+        h = (bits * self.coeff[: bits.shape[1]]).sum(dim=-1)
+        self.hashes[slot, :n].copy_(h)
+        self.rows[slot].fill_(n)
+
+    def _make_hook(self, name: str):
+        is_final_norm = name.endswith("model.norm") or name == "norm"
+        # The first decoder layer's input norm runs as a module in every
+        # forward (the embedding lookup does not always), and its first output
+        # is [tokens, hidden]: it fixes the token count for the regrouping.
+        sets_tokens = name.endswith("layers.0.input_layernorm")
+
+        def hook(module, args, output):
+            if sets_tokens:
+                first = output[0] if isinstance(output, (tuple, list)) else output
+                if isinstance(first, torch.Tensor):
+                    self._tokens = int(first.shape[0])
+            outs: List[Any]
+            if isinstance(output, torch.Tensor):
+                outs = [output]
+            elif isinstance(output, (tuple, list)):
+                outs = list(output)
+            elif hasattr(output, "next_token_logits"):
+                outs = [output.next_token_logits]
+            else:
+                return
+            for i, o in enumerate(outs):
+                if isinstance(o, torch.Tensor):
+                    self._record(name if i == 0 else f"{name}#{i}", o)
+            if is_final_norm and isinstance(outs[0], torch.Tensor):
+                self.head_in_name = name
+                t = outs[0]
+                if self.head_in is None or self.head_in.shape[1] != t.shape[-1]:
+                    self.head_in = torch.zeros(
+                        (_MAX_ROWS, t.shape[-1]), dtype=t.dtype, device=t.device
+                    )
+                self.head_in[: t.shape[0]].copy_(t.reshape(t.shape[0], -1))
+
+        return hook
+
+    # ------------------------------------------------------------ read-out
+    def begin(self, forward_batch, runner) -> None:
+        self._mode = forward_batch.forward_mode.name
+        self._tokens_real = int(forward_batch.input_ids.shape[0])
+        self.rows.zero_()
+        self._cache = {}
+        rids = forward_batch.rids or []
+        tapped = [i for i, r in enumerate(rids) if r and r.startswith(self.prefix)]
+        spans = self._spans(forward_batch) if tapped else None
+        if spans is None:
+            return
+        for i in tapped:
+            self._cache[i] = self._cache_hashes(
+                forward_batch, runner, i, spans[0][i][0]
+            )
+
+    def end(self, forward_batch, logits_output) -> None:
+        mode = self._mode
+        if len(self.names) != self._names_written:
+            (self.dir / "slots.json").write_text(
+                json.dumps({"names": self.names, "head_in": self.head_in_name})
+            )
+            self._names_written = len(self.names)
+        self.forward_count += 1
+        rids = forward_batch.rids or []
+        tapped = [i for i, r in enumerate(rids) if r and r.startswith(self.prefix)]
+        if not tapped:
+            return
+        torch.cuda.current_stream().synchronize()
+        fm = forward_batch.forward_mode
+        n_tokens = int(forward_batch.input_ids.shape[0])
+        bs = len(rids)
+        got = self._spans(forward_batch)
+        if got is None:
+            return
+        spans, logit_spans = got
+        logits = getattr(logits_output, "next_token_logits", None)
+        n_slots = len(self.names)
+        rows = self.rows[:n_slots].cpu()
+        ids = forward_batch.input_ids.cpu()
+        pos = forward_batch.positions.cpu()
+        for i in tapped:
+            a, b = spans[i]
+            la, lb = logit_spans[i]
+            hashes_tok = self.hashes[:n_slots, a:b].cpu()
+            hashes_req = self.hashes[:n_slots, la:lb].cpu()
+            rec: Dict[str, Any] = {
+                "mode": mode,
+                "forward_count": self.forward_count,
+                "batch_size": bs,
+                "num_tokens": n_tokens,
+                "row_start": a,
+                "input_ids": ids[a:b].numpy(),
+                "positions": pos[a:b].numpy(),
+                # Only slots whose row count equals this forward's token count
+                # are indexed by token; others (e.g. logits of an extend) by request.
+                "hash_rows": rows.numpy(),
+                "hashes_tok": hashes_tok.numpy(),
+                "hashes_req": hashes_req.numpy(),
+            }
+            if self.head_in is not None:
+                # A prefill keeps only its last row; decode and verify keep all.
+                prefill = fm.is_extend() and not fm.is_target_verify()
+                rec["head_in"] = (
+                    (self.head_in[b - 1 : b] if prefill else self.head_in[a:b])
+                    .float()
+                    .cpu()
+                    .numpy()
+                )
+            if logits is not None and logits.shape[0] >= lb:
+                lg = logits[la:lb].float()
+                top = torch.topk(lg, 16, dim=-1)
+                rec["top16_values"] = top.values.cpu().numpy()
+                rec["top16_ids"] = top.indices.cpu().numpy()
+                rec["argmax"] = torch.argmax(lg, dim=-1).cpu().numpy()
+                gap = top.values[:, 0] - top.values[:, 1]
+                keep = (gap <= self.full_gap).cpu()
+                rec["full_logits_rows"] = keep.nonzero().flatten().numpy()
+                if bool(keep.any()):
+                    rec["full_logits"] = lg[keep.to(lg.device)].cpu().numpy()
+            for k, v in self._cache.get(i, {}).items():
+                rec[k] = (
+                    v.cpu().numpy() if isinstance(v, torch.Tensor) else np.asarray(v)
+                )
+            out_dir = self.dir / rids[i]
+            out_dir.mkdir(parents=True, exist_ok=True)
+            np.savez(out_dir / f"{self.forward_count:07d}_{mode}.npz", **rec)
+
+
+_TAP: Optional[StateTap] = None
+
+
+def maybe_install(model: torch.nn.Module, device, is_draft_worker: bool) -> None:
+    global _TAP
+    if _TAP is None and not is_draft_worker and _enabled():
+        _TAP = StateTap(model, torch.device(device))
+
+
+def record(name: str, tensor: torch.Tensor) -> None:
+    """Tap a tensor that is not a module output (e.g. inside an attention backend)."""
+    if _TAP is not None:
+        _TAP._record(name, tensor)
+
+
+def begin(forward_batch, runner) -> None:
+    if _TAP is not None and not runner.is_draft_worker:
+        _TAP.begin(forward_batch, runner)
+
+
+def end(forward_batch, output, is_draft_worker: bool) -> None:
+    if _TAP is not None and not is_draft_worker:
+        _TAP.end(forward_batch, getattr(output, "logits_output", None))
