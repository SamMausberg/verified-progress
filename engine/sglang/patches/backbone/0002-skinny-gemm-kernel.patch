+"""Skinny BF16 GEMMs for small-batch decode, with optional fused prologues.
+
+Everything here is off unless ``SGLANG_BACKBONE_GEMM=1``; the switches are
+listed at ``GEMM_ENABLED`` below and in the backbone section of
+``engine/sglang/README.md`` in the verified-progress repository.
+
+At decode batch sizes the projections of a 4B model are weight-streaming
+problems: ``y[M, N] = a[M, K] @ W[N, K]^T`` with M <= 128 reads the N x K BF16
+weight once and little else. cuBLAS reaches the HBM read peak only on large
+weights; for the 2560-wide outputs (GDN ``out_proj``, attention ``o_proj``,
+MLP ``down_proj``) it splits K and adds a separate reduction kernel. This
+module provides one Triton kernel that
+
+* tiles N (and M for larger batches) and streams each weight row block once,
+  with an optional deterministic split-K: every split stores its FP32 partial
+  to a workspace slot, and the last split of a tile to arrive sums the slots
+  in split order, so the result does not depend on scheduling;
+* can compute its A operand from a prologue instead of reading it:
+  ``PROLOGUE_ADD_RMSNORM`` forms ``h = x + residual`` and the Gemma RMSNorm
+  ``h * rsqrt(mean(h^2) + eps) * (1 + g)`` in the arithmetic of FlashInfer's
+  ``gemma_fused_add_rmsnorm`` (FP32 ``h``, approximate rsqrt, BF16 output) and
+  writes the BF16 residual once; ``PROLOGUE_SILU_MUL`` forms
+  ``silu(gate) * up`` from a gate/up projection output as SGLang's JIT
+  ``silu_and_mul`` does (fast-math exp and division on sm_90);
+* can be launched with programmatic dependent launch (PDL): it waits for the
+  preceding kernel with ``griddepcontrol.wait`` before touching activations
+  and lets the next PDL kernel launch early.
+
+None of this is bitwise-equal to cuBLAS: the FP32 accumulation order differs,
+and the fused RMSNorm sums squares in a different order than FlashInfer.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+from dataclasses import asdict, dataclass, replace
+from typing import Iterator, Optional
+
+import torch
+import triton
+import triton.language as tl
+
+PROLOGUE_NONE = 0
+PROLOGUE_ADD_RMSNORM = 1
+PROLOGUE_SILU_MUL = 2
+
+# SiLU arithmetic: 0 for the CPU interpreter (no libdevice), 1 as nvcc
+# --use_fast_math compiles x / (1 + expf(-x)) (SGLang's JIT activation on
+# sm_90), 2 with IEEE division and accurate expf (its build on sm_100+).
+SILU_INTERPRETER = 0
+SILU_FAST = 1
+SILU_PRECISE = 2
+
+
+@dataclass(frozen=True)
+class GemmConfig:
+    """Launch configuration of one skinny GEMM."""
+
+    block_m: int
+    block_n: int
+    block_k: int
+    split_k: int = 1
+    use_dot: bool = True
+    num_warps: int = 4
+    num_stages: int = 3
+    pdl: bool = False
+
+    def valid_for(self, m: int, n: int, k: int) -> bool:
+        if n % self.block_n or k % (self.block_k * self.split_k):
+            return False
+        if self.use_dot and min(self.block_m, self.block_n, self.block_k) < 16:
+            return False
+        return not (self.split_k > 1 and m > self.block_m * 8)
+
+    def grid(self, m: int, n: int) -> tuple[int, int, int]:
+        return (n // self.block_n, self.split_k, triton.cdiv(m, self.block_m))
+
+
+_INTERPRET = os.environ.get("TRITON_INTERPRET") == "1"
+
+
+@triton.jit
+def _silu_f32(g, SILU_MODE: tl.constexpr):
+    if SILU_MODE == 1:
+        e = tl.extra.cuda.libdevice.fast_expf(-g)
+        return tl.extra.cuda.libdevice.fast_dividef(g, 1.0 + e)
+    elif SILU_MODE == 2:
+        e = tl.extra.cuda.libdevice.exp(-g)
+        return tl.extra.cuda.libdevice.div_rn(g, 1.0 + e)
+    else:
+        return g / (1.0 + tl.exp(-g))
+
+
+@triton.jit
+def _rmsnorm_rstd(
+    x_ptr,
+    r_ptr,
+    r_out_ptr,
+    offs_m,
+    mask_m,
+    stride_xm,
+    K,
+    eps,
+    write_r,
+    HAS_RESIDUAL: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+):
+    """rsqrt(mean(h^2) + eps) per row over all of K, h = x (+ residual) in FP32.
+
+    Where ``write_r`` holds, also stores bf16(h) to r_out (the new residual).
+    """
+    offs_kk = tl.arange(0, BLOCK_K)
+    sum_sq = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    for k0 in range(0, K, BLOCK_K):
+        idx = offs_m[:, None] * stride_xm + (k0 + offs_kk)[None, :]
+        h = tl.load(x_ptr + idx, mask=mask_m[:, None], other=0.0).to(tl.float32)
+        if HAS_RESIDUAL:
+            h += tl.load(r_ptr + idx, mask=mask_m[:, None], other=0.0).to(tl.float32)
+            tl.store(r_out_ptr + idx, h.to(tl.bfloat16), mask=mask_m[:, None] & write_r)
+        sum_sq += tl.sum(h * h, axis=1)
+    return tl.math.rsqrt(sum_sq / K + eps)
+
+
+@triton.jit
+def _a_tile(
+    x_ptr,
+    r_ptr,
+    g_ptr,
+    offs_m,
+    mask_m,
+    offs_k,
+    stride_xm,
+    K,
+    rstd,
+    PROLOGUE: tl.constexpr,
+    HAS_RESIDUAL: tl.constexpr,
+    SILU_MODE: tl.constexpr,
+):
+    """The BF16 A operand for rows offs_m and columns offs_k."""
+    idx = offs_m[:, None] * stride_xm + offs_k[None, :]
+    if PROLOGUE == 0:
+        a = tl.load(x_ptr + idx, mask=mask_m[:, None], other=0.0)
+    elif PROLOGUE == 1:
+        h = tl.load(x_ptr + idx, mask=mask_m[:, None], other=0.0).to(tl.float32)
+        if HAS_RESIDUAL:
+            h += tl.load(r_ptr + idx, mask=mask_m[:, None], other=0.0).to(tl.float32)
+        g = tl.load(g_ptr + offs_k).to(tl.float32) + 1.0
+        a = (h * rstd[:, None] * g[None, :]).to(tl.bfloat16)
+    else:
+        gate = tl.load(x_ptr + idx, mask=mask_m[:, None], other=0.0).to(tl.float32)
+        up = tl.load(x_ptr + idx + K, mask=mask_m[:, None], other=0.0).to(tl.float32)
+        a = (_silu_f32(gate, SILU_MODE) * up).to(tl.bfloat16)
+    return a
+
+
+# M is not specialized, so one binary per configuration serves every batch size.
+@triton.jit(do_not_specialize=["M"])
+def _bb_gemm_kernel(
+    x_ptr,
+    w_ptr,
+    y_ptr,
+    r_ptr,
+    g_ptr,
+    r_out_ptr,
+    ws_ptr,
+    cnt_ptr,
+    M,
+    N,
+    K,
+    eps,
+    stride_xm,
+    stride_ym,
+    PROLOGUE: tl.constexpr,
+    HAS_RESIDUAL: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_N: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    SPLIT_K: tl.constexpr,
+    USE_DOT: tl.constexpr,
+    PDL: tl.constexpr,
+    SILU_MODE: tl.constexpr,
+    BF16_DOT: tl.constexpr,
+):
+    """y[M, N] = A[M, K] @ W[N, K]^T with A read or computed by the prologue.
+
+    W is contiguous [N, K]; y has row stride ``stride_ym``. PROLOGUE_NONE: x is
+    A with row stride ``stride_xm``. PROLOGUE_ADD_RMSNORM: x and residual are
+    [M, K] with row stride ``stride_xm``, g is the Gemma norm weight [K], and the
+    program at (pid_n, pid_k) = (0, 0) of each row block writes
+    ``bf16(x + residual)`` to r_out. PROLOGUE_SILU_MUL: x is the [M, 2K]
+    gate/up output with row stride ``stride_xm``.
+    """
+    pid_n = tl.program_id(0)
+    pid_k = tl.program_id(1)
+    pid_m = tl.program_id(2)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)
+    offs_kk = tl.arange(0, BLOCK_K)
+    mask_m = offs_m < M
+    k_len = K // SPLIT_K
+    k_lo = pid_k * k_len
+
+    if PDL:
+        # Nothing below may read a predecessor's output or write anything
+        # before this wait; the weights are never written by anyone.
+        tl.extra.cuda.gdc_wait()
+        tl.extra.cuda.gdc_launch_dependents()
+
+    rstd = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    if PROLOGUE == 1:
+        rstd = _rmsnorm_rstd(
+            x_ptr,
+            r_ptr,
+            r_out_ptr,
+            offs_m,
+            mask_m,
+            stride_xm,
+            K,
+            eps,
+            (pid_n == 0) & (pid_k == 0),
+            HAS_RESIDUAL,
+            BLOCK_M,
+            BLOCK_K,
+        )
+
+    if USE_DOT:
+        acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+    else:
+        acc3 = tl.zeros((BLOCK_M, BLOCK_N, BLOCK_K), dtype=tl.float32)
+    for k0 in range(k_lo, k_lo + k_len, BLOCK_K):
+        offs_k = k0 + offs_kk
+        w = tl.load(
+            w_ptr + offs_n[:, None] * K + offs_k[None, :],
+            eviction_policy="evict_first",
+        )
+        a = _a_tile(
+            x_ptr,
+            r_ptr,
+            g_ptr,
+            offs_m,
+            mask_m,
+            offs_k,
+            stride_xm,
+            K,
+            rstd,
+            PROLOGUE,
+            HAS_RESIDUAL,
+            SILU_MODE,
+        )
+        if USE_DOT and BF16_DOT:
+            acc = tl.dot(a, tl.trans(w), acc)
+        elif USE_DOT:  # CPU interpreter: its BF16 dot is unreliable
+            acc = tl.dot(a.to(tl.float32), tl.trans(w.to(tl.float32)), acc)
+        else:
+            acc3 += a.to(tl.float32)[:, None, :] * w.to(tl.float32)[None, :, :]
+    if not USE_DOT:
+        acc = tl.sum(acc3, axis=2)
+
+    y_ptrs = y_ptr + offs_m[:, None] * stride_ym + offs_n[None, :]
+    if SPLIT_K == 1:
+        tl.store(y_ptrs, acc.to(tl.bfloat16), mask=mask_m[:, None])
+    else:
+        # Deterministic split-K: slot pid_k of this tile holds the partial; the
+        # last split to arrive adds the slots in split order.
+        tile = pid_m * tl.num_programs(0) + pid_n
+        slot = BLOCK_M * BLOCK_N
+        ws_tile = ws_ptr + tile.to(tl.int64) * (SPLIT_K * slot)
+        loc = tl.arange(0, BLOCK_M)[:, None] * BLOCK_N + tl.arange(0, BLOCK_N)[None, :]
+        tl.store(ws_tile + pid_k * slot + loc, acc, cache_modifier=".cg")
+        tl.debug_barrier()
+        arrived = tl.atomic_add(cnt_ptr + tile, 1, sem="acq_rel", scope="gpu")
+        if arrived == SPLIT_K - 1:
+            total = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)
+            for s in tl.static_range(SPLIT_K):
+                total += tl.load(ws_tile + s * slot + loc, cache_modifier=".cg")
+            tl.store(y_ptrs, total.to(tl.bfloat16), mask=mask_m[:, None])
+            tl.atomic_xchg(cnt_ptr + tile, 0)
+
+
+@triton.jit(do_not_specialize=["M"])
+def _bb_prologue_kernel(
+    x_ptr,
+    r_ptr,
+    g_ptr,
+    r_out_ptr,
+    a_ptr,
+    M,
+    K,
+    eps,
+    stride_xm,
+    PROLOGUE: tl.constexpr,
+    HAS_RESIDUAL: tl.constexpr,
+    BLOCK_M: tl.constexpr,
+    BLOCK_K: tl.constexpr,
+    SILU_MODE: tl.constexpr,
+):
+    """Write the GEMM kernel's A operand ([M, K] BF16) for testing: the same
+    prologue code, stored instead of multiplied."""
+    pid_m = tl.program_id(0)
+    offs_m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)
+    mask_m = offs_m < M
+    rstd = tl.zeros((BLOCK_M,), dtype=tl.float32)
+    if PROLOGUE == 1:
+        rstd = _rmsnorm_rstd(
+            x_ptr,
+            r_ptr,
+            r_out_ptr,
+            offs_m,
+            mask_m,
+            stride_xm,
+            K,
+            eps,
+            True,
+            HAS_RESIDUAL,
+            BLOCK_M,
+            BLOCK_K,
+        )
+    for k0 in range(0, K, BLOCK_K):
+        offs_k = k0 + tl.arange(0, BLOCK_K)
+        a = _a_tile(
+            x_ptr,
+            r_ptr,
+            g_ptr,
+            offs_m,
+            mask_m,
+            offs_k,
+            stride_xm,
+            K,
+            rstd,
+            PROLOGUE,
+            HAS_RESIDUAL,
+            SILU_MODE,
+        )
+        tl.store(a_ptr + offs_m[:, None] * K + offs_k[None, :], a, mask=mask_m[:, None])
+
+
+def default_silu_mode(device: torch.device) -> int:
+    if _INTERPRET or device.type != "cuda":
+        return SILU_INTERPRETER
+    major, _ = torch.cuda.get_device_capability(device)
+    # SGLang's JIT activation compiles with --use_fast_math below sm_100.
+    return SILU_FAST if major < 10 else SILU_PRECISE
+
+
+# Split-K scratch, one workspace and counter array per device. Kernels on one
+# stream run in order (with PDL nothing is touched before the predecessor
+# completes), so they can share it; split-K launches must not run concurrently
+# on two streams. Allocate it outside graph capture (an eager call first).
+_SCRATCH: dict[int, tuple[torch.Tensor, torch.Tensor]] = {}
+_SCRATCH_FLOATS = int(
+    os.environ.get("SGLANG_BACKBONE_GEMM_SCRATCH_FLOATS", str(8 << 20))
+)
+_SCRATCH_TILES = 1 << 16
+
+
+def _scratch(device: torch.device) -> tuple[torch.Tensor, torch.Tensor]:
+    key = (device.index or 0) if device.type == "cuda" else -1  # -1: interpreter
+    pair = _SCRATCH.get(key)
+    if pair is None:
+        if device.type == "cuda" and torch.cuda.is_current_stream_capturing():
+            raise RuntimeError(
+                "backbone_gemm: split-K scratch must be allocated before CUDA graph "
+                "capture; run one eager call first"
+            )
+        pair = (
+            torch.empty(_SCRATCH_FLOATS, dtype=torch.float32, device=device),
+            torch.zeros(_SCRATCH_TILES, dtype=torch.int32, device=device),
+        )
+        _SCRATCH[key] = pair
+    return pair
+
+
+def _check_prologue_args(
+    x: torch.Tensor,
+    k: int,
+    prologue: int,
+    residual: Optional[torch.Tensor],
+    norm_weight: Optional[torch.Tensor],
+    residual_out: Optional[torch.Tensor],
+) -> None:
+    assert x.dtype == torch.bfloat16 and x.stride(-1) == 1 and x.dim() == 2
+    if prologue == PROLOGUE_SILU_MUL:
+        assert x.shape[1] == 2 * k
+    else:
+        assert x.shape[1] == k
+    if prologue == PROLOGUE_ADD_RMSNORM:
+        assert norm_weight is not None and norm_weight.shape == (k,)
+        assert x.is_contiguous()
+        if residual is not None:
+            assert residual_out is not None
+            assert residual.is_contiguous() and residual_out.is_contiguous()
+            assert residual.shape == x.shape == residual_out.shape
+            assert residual_out.data_ptr() not in (x.data_ptr(), residual.data_ptr())
+
+
+def skinny_gemm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    cfg: GemmConfig,
+    *,
+    prologue: int = PROLOGUE_NONE,
+    residual: Optional[torch.Tensor] = None,
+    norm_weight: Optional[torch.Tensor] = None,
+    eps: float = 1e-6,
+    residual_out: Optional[torch.Tensor] = None,
+    out: Optional[torch.Tensor] = None,
+    silu_mode: Optional[int] = None,
+) -> torch.Tensor:
+    """Run ``_bb_gemm_kernel``; returns y [M, N] (BF16).
+
+    prologue PROLOGUE_NONE: x is A [M, K].
+    PROLOGUE_ADD_RMSNORM: x is the previous layer output [M, K]; residual
+        (optional, [M, K]) is added first and ``bf16(x + residual)`` is written
+        to residual_out, which must not alias x or residual; norm_weight [K]
+        is the Gemma weight (the kernel multiplies by 1 + g).
+    PROLOGUE_SILU_MUL: x is the gate/up output [M, 2K].
+    """
+    n, k = weight.shape
+    m = x.shape[0]
+    assert weight.is_contiguous() and weight.dtype == torch.bfloat16
+    assert n * k < 2**31 and m * max(x.stride(0), n) < 2**31
+    _check_prologue_args(x, k, prologue, residual, norm_weight, residual_out)
+    if not cfg.valid_for(m, n, k):
+        raise ValueError(f"config {cfg} does not tile m={m} n={n} k={k}")
+    y = out if out is not None else x.new_empty((m, n))
+    grid = cfg.grid(m, n)
+    if cfg.split_k > 1:
+        ws, cnt = _scratch(x.device)
+        tiles = grid[0] * grid[2]
+        assert tiles <= cnt.numel(), "split-K tile count exceeds the counter array"
+        assert tiles * cfg.split_k * cfg.block_m * cfg.block_n <= ws.numel(), (
+            "split-K workspace too small; raise SGLANG_BACKBONE_GEMM_SCRATCH_FLOATS"
+        )
+    else:
+        ws, cnt = y, y  # unused
+    has_residual = residual is not None
+    _bb_gemm_kernel[grid](
+        x,
+        weight,
+        y,
+        residual if has_residual else x,
+        norm_weight if norm_weight is not None else x,
+        residual_out if has_residual else x,
+        ws,
+        cnt,
+        m,
+        n,
+        k,
+        eps,
+        x.stride(0),
+        y.stride(0),
+        PROLOGUE=prologue,
+        HAS_RESIDUAL=has_residual,
+        BLOCK_M=cfg.block_m,
+        BLOCK_N=cfg.block_n,
+        BLOCK_K=cfg.block_k,
+        SPLIT_K=cfg.split_k,
+        USE_DOT=cfg.use_dot,
+        PDL=cfg.pdl,
+        SILU_MODE=default_silu_mode(x.device) if silu_mode is None else silu_mode,
+        BF16_DOT=not _INTERPRET,
+        num_warps=cfg.num_warps,
+        num_stages=cfg.num_stages,
+        launch_pdl=cfg.pdl,
+    )
+    return y
+
+
+def prologue_probe(
+    x: torch.Tensor,
+    k: int,
+    prologue: int,
+    *,
+    residual: Optional[torch.Tensor] = None,
+    norm_weight: Optional[torch.Tensor] = None,
+    eps: float = 1e-6,
+    residual_out: Optional[torch.Tensor] = None,
+    block_m: int = 16,
+    block_k: int = 256,
+    silu_mode: Optional[int] = None,
+) -> torch.Tensor:
+    """The A operand the GEMM kernel forms for this prologue, as a [M, K] tensor."""
+    _check_prologue_args(x, k, prologue, residual, norm_weight, residual_out)
+    assert k % block_k == 0
+    m = x.shape[0]
+    a = x.new_empty((m, k))
+    has_residual = residual is not None
+    _bb_prologue_kernel[(triton.cdiv(m, block_m),)](
+        x,
+        residual if has_residual else x,
+        norm_weight if norm_weight is not None else x,
+        residual_out if has_residual else x,
+        a,
+        m,
+        k,
+        eps,
+        x.stride(0),
+        PROLOGUE=prologue,
+        HAS_RESIDUAL=has_residual,
+        BLOCK_M=block_m,
+        BLOCK_K=block_k,
+        SILU_MODE=default_silu_mode(x.device) if silu_mode is None else silu_mode,
+    )
+    return a
+
+
+def reference(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    *,
+    prologue: int = PROLOGUE_NONE,
+    residual: Optional[torch.Tensor] = None,
+    norm_weight: Optional[torch.Tensor] = None,
+    eps: float = 1e-6,
+) -> tuple[torch.Tensor, Optional[torch.Tensor]]:
+    """Float64 reference: (y in float64, bf16 residual or None).
+
+    The prologue's A operand is formed in FP32 and rounded to BF16 as the
+    kernel does; only the GEMM itself is evaluated in float64.
+    """
+    res_out = None
+    if prologue == PROLOGUE_ADD_RMSNORM:
+        h = x.float()
+        if residual is not None:
+            h = h + residual.float()
+            res_out = h.to(torch.bfloat16)
+        rstd = torch.rsqrt(h.pow(2).mean(dim=-1, keepdim=True) + eps)
+        assert norm_weight is not None
+        a = (h * rstd * (norm_weight.float() + 1.0)).to(torch.bfloat16)
+    elif prologue == PROLOGUE_SILU_MUL:
+        k = weight.shape[1]
+        gate, up = x[:, :k].float(), x[:, k:].float()
+        a = (gate / (1.0 + torch.exp(-gate)) * up).to(torch.bfloat16)
+    else:
+        a = x
+    return a.double() @ weight.double().T, res_out
+
+
+# ----------------------------------------------------------------------------
+# Routing policy (read once at import; every switch defaults to off)
+
+
+def _env_flag(name: str) -> bool:
+    return os.environ.get(name, "0").strip().lower() in ("1", "true", "yes", "on")
+
+
+# SGLANG_BACKBONE_GEMM: route BF16 projections whose (N, K, M) has an entry in
+# the table below to the Triton kernel instead of cuBLAS.
+GEMM_ENABLED = _env_flag("SGLANG_BACKBONE_GEMM")
+# SGLANG_BACKBONE_PDL: launch those kernels with programmatic dependent launch.
+USE_PDL = _env_flag("SGLANG_BACKBONE_PDL")
+# SGLANG_BACKBONE_FUSE_ACT: fold SiLU-mul into the MLP down projection.
+FUSE_ACT = GEMM_ENABLED and _env_flag("SGLANG_BACKBONE_FUSE_ACT")
+# SGLANG_BACKBONE_FUSE_NORM: fold the residual add and Gemma RMSNorm in front
+# of a projection into that projection's prologue (see DeferredNormInput).
+FUSE_NORM = GEMM_ENABLED and _env_flag("SGLANG_BACKBONE_FUSE_NORM")
+# SGLANG_BACKBONE_MERGE_IN_PROJ: one GEMM for the GDN in_proj_qkvz and
+# in_proj_ba (SGLang's packed-weight path, otherwise ROCm-only), cuBLAS or Triton.
+MERGE_IN_PROJ = _env_flag("SGLANG_BACKBONE_MERGE_IN_PROJ")
+
+# (N, K) -> ((m_max, config or None, mode), ...) in increasing m_max: the first
+# entry with m <= m_max applies; None keeps cuBLAS for that M range, and M beyond
+# the last entry stays on cuBLAS. mode "gemm": every call; "fused": only when a
+# prologue (norm or SiLU) is folded into the call, i.e. where the Triton GEMM
+# alone does not beat cuBLAS but the saved launch pays. Tuned on GH200 under
+# CUDA graphs (verified-progress, experiments/backbone/gemm_bench.py and
+# make_table.py).
+TableEntry = tuple[int, Optional[GemmConfig], str]
+TABLE: dict[tuple[int, int], tuple[TableEntry, ...]] = {}
+
+
+def _load_table_override() -> None:
+    path = os.environ.get("SGLANG_BACKBONE_GEMM_TABLE")
+    if not path:
+        return
+    with open(path) as f:
+        data = json.load(f)
+    TABLE.clear()
+    for key, entries in data.items():
+        n, k = (int(v) for v in key.split(","))
+        TABLE[(n, k)] = tuple(
+            (int(m_max), None if cfg is None else GemmConfig(**cfg), mode)
+            for m_max, cfg, mode in sorted(entries, key=lambda e: e[0])
+        )
+
+
+_load_table_override()
+
+
+def select(m: int, n: int, k: int, fused: bool = False) -> Optional[GemmConfig]:
+    """The configuration for this problem, or None to keep cuBLAS."""
+    for m_max, cfg, mode in TABLE.get((n, k), ()):
+        if m <= m_max:
+            if cfg is None or (mode == "fused" and not fused):
+                return None
+            if not cfg.valid_for(m, n, k):
+                return None
+            return replace(cfg, pdl=USE_PDL) if cfg.pdl != USE_PDL else cfg
+    return None
+
+
+def maybe_linear(x: torch.Tensor, weight: torch.Tensor) -> Optional[torch.Tensor]:
+    """``F.linear(x, weight)`` through the Triton kernel when the policy routes
+    it there, else None."""
+    if not (
+        GEMM_ENABLED
+        and x.dim() == 2
+        and x.is_cuda
+        and x.dtype == torch.bfloat16
+        and weight.dtype == torch.bfloat16
+        and x.stride(-1) == 1
+        and weight.is_contiguous()
+        and not torch.compiler.is_compiling()
+    ):
+        return None
+    cfg = select(x.shape[0], weight.shape[0], weight.shape[1])
+    if cfg is None or x.shape[0] == 0:
+        return None
+    return skinny_gemm(x, weight, cfg)
+
+
+def table_as_json() -> dict[str, list]:
+    return {
+        f"{n},{k}": [
+            [m_max, None if cfg is None else asdict(cfg), mode]
+            for m_max, cfg, mode in entries
+        ]
+        for (n, k), entries in TABLE.items()
+    }
+
+
+# ----------------------------------------------------------------------------
+# Deferred RMSNorm: the norm in front of a projection, computed in its prologue
+
+
+class DeferredNormInput:
+    """A projection input owed as ``GemmaRMSNorm(x + residual)``.
+
+    Returned by the residual readout instead of the normalized tensor when the
+    caller opened ``defer_norm_into(weight)`` for the projection that consumes
+    it. ``linear()`` computes that projection with the add-RMSNorm prologue,
+    which also writes ``bf16(x + residual)`` into ``residual_out`` (the tensor
+    the readout returned as the new residual), so it must run before anything
+    reads the new residual; on the decoder-layer paths the consumer is the
+    stage's first projection. ``materialize()`` runs the stock FlashInfer norm
+    instead (any other consumer).
+    """
+
+    __slots__ = ("x", "residual", "norm_weight", "eps", "residual_out")
+
+    def __init__(
+        self,
+        x: torch.Tensor,
+        residual: torch.Tensor,
+        norm_weight: torch.Tensor,
+        eps: float,
+        residual_out: torch.Tensor,
+    ) -> None:
+        self.x = x
+        self.residual = residual
+        self.norm_weight = norm_weight
+        self.eps = eps
+        self.residual_out = residual_out
+
+    @property
+    def shape(self) -> torch.Size:
+        return self.x.shape
+
+    @property
+    def dtype(self) -> torch.dtype:
+        return self.x.dtype
+
+    @property
+    def device(self) -> torch.device:
+        return self.x.device
+
+    def dim(self) -> int:
+        return self.x.dim()
+
+    def materialize(self) -> torch.Tensor:
+        from sgl_kernel import gemma_fused_add_rmsnorm
+
+        self.residual_out.copy_(self.residual)
+        out = self.x.clone()
+        gemma_fused_add_rmsnorm(out, self.residual_out, self.norm_weight, self.eps)
+        return out
+
+    def linear(
+        self, weight: torch.Tensor, bias: Optional[torch.Tensor] = None
+    ) -> torch.Tensor:
+        cfg = None
+        if bias is None and weight.dtype == torch.bfloat16 and weight.is_contiguous():
+            cfg = select(self.x.shape[0], weight.shape[0], weight.shape[1], fused=True)
+        if cfg is None or weight.shape[1] != self.x.shape[1]:
+            return torch.nn.functional.linear(self.materialize(), weight, bias)
+        return skinny_gemm(
+            self.x,
+            weight,
+            cfg,
+            prologue=PROLOGUE_ADD_RMSNORM,
+            residual=self.residual,
+            norm_weight=self.norm_weight,
+            eps=self.eps,
+            residual_out=self.residual_out,
+        )
+
+
+_DEFER_CONSUMER: list[Optional[torch.Tensor]] = [None]
+
+
+@contextlib.contextmanager
+def defer_norm_into(weight: Optional[torch.Tensor]) -> Iterator[None]:
+    """Let the next residual read defer its norm into the projection ``weight``
+    (None, or FUSE_NORM off: no deferral)."""
+    prev = _DEFER_CONSUMER[0]
+    _DEFER_CONSUMER[0] = weight if FUSE_NORM else None
+    try:
+        yield
+    finally:
+        _DEFER_CONSUMER[0] = prev
+
+
+def maybe_defer_norm(
+    update, hidden_states, residual, norm, quant_format, post_residual_addition
+) -> Optional[tuple[DeferredNormInput, torch.Tensor]]:
+    """(DeferredNormInput, new residual) for a deferrable plain add + Gemma
+    RMSNorm read inside ``defer_norm_into``, else None (the stock path runs)."""
+    weight = _DEFER_CONSUMER[0]
+    if weight is None:
+        return None
+    _DEFER_CONSUMER[0] = None  # one read per context
+    if not (
+        getattr(update, "is_plain_add", False)
+        and residual is not None
+        and not quant_format
+        and post_residual_addition is None
+        and type(norm).__name__ == "GemmaRMSNorm"
+        and isinstance(hidden_states, torch.Tensor)
+        and isinstance(residual, torch.Tensor)
+        and hidden_states.dim() == 2
+        and hidden_states.shape == residual.shape
+        and hidden_states.shape[0] > 0
+        and hidden_states.dtype == residual.dtype == torch.bfloat16
+        and hidden_states.is_cuda
+        and hidden_states.is_contiguous()
+        and residual.is_contiguous()
+        and not torch.compiler.is_compiling()
+        and select(hidden_states.shape[0], weight.shape[0], weight.shape[1], fused=True)
+        is not None
+    ):
+        return None
+    residual_out = torch.empty_like(residual)
+    deferred = DeferredNormInput(
+        hidden_states, residual, norm.weight.data, norm.variance_epsilon, residual_out
+    )
+    return deferred, residual_out
