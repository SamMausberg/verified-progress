From 6ca40e754747f67da8afcc1a3fd637065540423d Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Thu, 1 Oct 2026 03:19:53 +0000
Subject: [PATCH] GDN: opt-in fold-every-commit buffered verify
 (SGLANG_GDN_REPLAYSSM_FOLD)

Under --enable-linear-replayssm-spec, GDN pools used only the compact circular
replay, whose verify output is a chunked reconstruction, not the recurrent
kernel's. The fold-every-commit protocol (recurrent verify writing the raw
window to a ring, then a bitwise clone of the recurrent update replaying the
accepted prefix on commit) was implemented for GDN but enabled only for KDA.
SGLANG_GDN_REPLAYSSM_FOLD=1 enables it for GDN pools; the DFLASH direct commit
hook routes to the GDN fold when it is on. Off by default.
---
 python/sglang/srt/environ.py                  |  4 ++
 .../attention/hybrid_linear_attn_backend.py   | 38 ++++++++++++++-----
 .../srt/mem_cache/kv_cache_configurator.py    |  8 +++-
 python/sglang/srt/mem_cache/memory_pool.py    | 14 +++++--
 4 files changed, 51 insertions(+), 13 deletions(-)

diff --git a/python/sglang/srt/environ.py b/python/sglang/srt/environ.py
index f3571906ff..6a71873da2 100644
--- a/python/sglang/srt/environ.py
+++ b/python/sglang/srt/environ.py
@@ -486,6 +486,10 @@ class Envs:
     SGLANG_DETECT_SLOW_RANK = EnvBool(False)
     SGLANG_DEBUG_MEMORY_POOL = EnvBool(False)
     SGLANG_VALIDATE_MAMBA_REPLAY_STATE_INDICES = EnvBool(False)
+    # GDN --enable-linear-replayssm-spec in fold-every-commit mode: verify with the
+    # recurrent kernel writing raw inputs to a ring, fold the accepted prefix on
+    # commit (instead of the compact circular replay).
+    SGLANG_GDN_REPLAYSSM_FOLD = EnvBool(False)
     SGLANG_GDN_DECODE_FUSION_LOG_LAYER_HITS = EnvBool(False)
     SGLANG_GDN_DECODE_FUSION_VERIFY_REAL_TENSORS = EnvBool(False)
     # NaN-fill the unified memory pool at boot (debug repro switch).
diff --git a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
index e8beb66cb4..c522fad003 100644
--- a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
+++ b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
@@ -1533,18 +1533,19 @@ class HybridLinearAttnBackend(AttentionBackend):
         and commit through this hook directly (DFLASH).
 
         Same operations, in the same order and on the same index sets, as the GDN
-        circular-ring branch of spec_utils.commit_mamba_states_after_verify, which
-        EAGLE/MTP reaches: advance the per-request ring cursors by the accepted
-        count, fold the ring into `temporal` where it is full or a track crossing
-        needs the exact state, then roll back the conv windows. Returns False when
+        branches of spec_utils.commit_mamba_states_after_verify, which EAGLE/MTP
+        reaches. Circular ring (default): advance the per-request ring cursors by
+        the accepted count, fold the ring into `temporal` where it is full or a
+        track crossing needs the exact state, then roll back the conv windows.
+        Fold-every-commit (SGLANG_GDN_REPLAYSSM_FOLD=1): replay the accepted raw
+        window into `temporal`, then roll back the conv windows. Returns False when
         the pool has no GDN spec ring (flag off, or a KDA model).
         """
         mamba_pool = getattr(req_pool, "mamba_pool", None)
-        if (
-            mamba_pool is None
-            or getattr(mamba_pool, "replayssm_cache_base", None) is None
-            or getattr(mamba_pool, "replayssm_is_kda", False)
-        ):
+        if mamba_pool is None or getattr(mamba_pool, "replayssm_is_kda", False):
+            return False
+        fold = getattr(mamba_pool, "replayssm_spec_fold", False)
+        if not fold and getattr(mamba_pool, "replayssm_cache_base", None) is None:
             return False
         if req_pool_indices is None:
             raise RuntimeError(
@@ -1552,6 +1553,25 @@ class HybridLinearAttnBackend(AttentionBackend):
             )
         if last_correct_step_indices.numel() == 0:
             return True
+        if fold:
+            # Fold-every-commit (SGLANG_GDN_REPLAYSSM_FOLD): the verify ran the
+            # recurrent kernel and stored the raw window; replay the accepted
+            # prefix into `temporal` with the kernel's bitwise clone, as the GDN
+            # fold branch of spec_utils.commit_mamba_states_after_verify does.
+            from sglang.kernels.ops.attention.fla.gdn_replayssm_spec_fold import (
+                commit_gdn_replayssm_fold_after_verify,
+            )
+
+            commit_gdn_replayssm_fold_after_verify(
+                spec_state=req_pool.get_speculative_mamba2_params_all_layers(),
+                state_batch_indices=req_pool.get_mamba_indices(req_pool_indices),
+                accept_lens=(last_correct_step_indices + 1).to(torch.int32),
+                last_correct_step_indices=last_correct_step_indices,
+                mamba_track_indices=mamba_track_indices,
+                mamba_steps_to_track=mamba_steps_to_track,
+                null_block_id=-1,
+            )
+            return True
         from sglang.kernels.ops.attention.fla.gdn_replayssm_spec_decode import (
             commit_gdn_replayssm_circular,
             commit_gdn_replayssm_spec,
diff --git a/python/sglang/srt/mem_cache/kv_cache_configurator.py b/python/sglang/srt/mem_cache/kv_cache_configurator.py
index 35bc56db5c..8f8882bef4 100644
--- a/python/sglang/srt/mem_cache/kv_cache_configurator.py
+++ b/python/sglang/srt/mem_cache/kv_cache_configurator.py
@@ -2476,7 +2476,13 @@ class KVCacheConfigurator:
         else:
             replayssm_ring_per_req = 0
         replayssm_ring_per_req = int(replayssm_ring_per_req * pp_layer_scale)
-        if replayssm_active and self.hybrid_kda_config is None:
+        # GDN compact replay is request scratch; the fold-every-commit rings (KDA,
+        # and GDN under SGLANG_GDN_REPLAYSSM_FOLD) are attached to each mamba slot.
+        if (
+            replayssm_active
+            and self.hybrid_kda_config is None
+            and not envs.SGLANG_GDN_REPLAYSSM_FOLD.get()
+        ):
             replay_req_slots = (
                 get_schedule().max_running_requests // self.attn_dp_size + 1
             )
diff --git a/python/sglang/srt/mem_cache/memory_pool.py b/python/sglang/srt/mem_cache/memory_pool.py
index aa8a3b44bf..480b90ca10 100644
--- a/python/sglang/srt/mem_cache/memory_pool.py
+++ b/python/sglang/srt/mem_cache/memory_pool.py
@@ -567,7 +567,8 @@ class MambaPool:
         # `_replayssm_on`.
         self.enable_linear_replayssm_spec = enable_linear_replayssm_spec
         self.replayssm_spec_fold = bool(
-            enable_linear_replayssm_spec and cache_params.is_kda
+            enable_linear_replayssm_spec
+            and (cache_params.is_kda or envs.SGLANG_GDN_REPLAYSSM_FOLD.get())
         )
         _replayssm_on = enable_linear_replayssm or enable_linear_replayssm_spec
 
@@ -659,9 +660,14 @@ class MambaPool:
                 L = linear_replayssm_cache_len
                 # GDN speculative replay is request-lifetime scratch. Size it by
                 # active requests instead of every persistent radix-cache slot.
+                # The fold-every-commit rings (KDA, and GDN under
+                # SGLANG_GDN_REPLAYSSM_FOLD) are indexed by the physical mamba
+                # slot, both in the ring-writing verify and in the fold.
                 num_slots = (
                     spec_state_size + 1
-                    if enable_linear_replayssm_spec and not cache_params.is_kda
+                    if enable_linear_replayssm_spec
+                    and not cache_params.is_kda
+                    and not self.replayssm_spec_fold
                     else size + 1
                 )
                 # Decode records follow the SSM dtype. Spec-verify compact d/k
@@ -709,7 +715,9 @@ class MambaPool:
                 )
                 # KDA still uses raw-input fold-every-commit. GDN materializes
                 # its compact d/k/g history directly and needs no duplicate ring.
-                if enable_linear_replayssm_spec and cache_params.is_kda:
+                if enable_linear_replayssm_spec and (
+                    cache_params.is_kda or self.replayssm_spec_fold
+                ):
                     if cache_params.is_kda or not self.replayssm_spec_fold:
                         # Backstop for the KDA ring invariants; this pool is
                         # sized with the final adaptive-aware draft maximum.
-- 
2.34.1

