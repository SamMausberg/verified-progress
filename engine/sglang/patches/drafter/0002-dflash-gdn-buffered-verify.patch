From bbf30af19acb4ee2c427513cc9e0465e7b77652e Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Thu, 1 Oct 2026 04:23:33 +0000
Subject: [PATCH] DFLASH: buffered GDN verify commit under
 --enable-linear-replayssm-spec

DFLASH verifies a linear chain and commits through the backend hook
update_mamba_state_after_mtp_verify, which only knew the KDA ReplaySSM fold;
on a GDN model the KDA-only check refused the flag. Add the GDN circular-ring
commit to the hook (the same kernels, order and index sets as the GDN branch of
spec_utils.commit_mamba_states_after_verify that EAGLE/MTP reaches) and allow
the flag for DFLASH on GDN models. Off unless --enable-linear-replayssm-spec.
---
 .../attention/hybrid_linear_attn_backend.py   | 96 ++++++++++++++++++-
 .../srt/mem_cache/kv_cache_configurator.py    | 15 ++-
 2 files changed, 104 insertions(+), 7 deletions(-)

diff --git a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
index e04f2fe354..e8beb66cb4 100644
--- a/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
+++ b/python/sglang/srt/layers/attention/hybrid_linear_attn_backend.py
@@ -1431,8 +1431,17 @@ class HybridLinearAttnBackend(AttentionBackend):
         slot ids instead of reusing this step's ``forward_metadata``; the scatter
         below reads the metadata it just planned.
         """
-        del req_pool_indices
         request_number = last_correct_step_indices.shape[0]
+        req_pool = self.linear_attn_backend.req_to_token_pool
+        if self._commit_gdn_replayssm_after_direct_verify(
+            req_pool,
+            last_correct_step_indices,
+            mamba_track_indices,
+            mamba_steps_to_track,
+            req_pool_indices,
+        ):
+            return
+        del req_pool_indices
 
         # `mamba_track_indices` is VIRTUAL; the scatter writes physical views.
         if mamba_track_indices is not None:
@@ -1446,7 +1455,6 @@ class HybridLinearAttnBackend(AttentionBackend):
             ]
         )
 
-        req_pool = self.linear_attn_backend.req_to_token_pool
         mamba_caches = req_pool.get_speculative_mamba2_params_all_layers()
 
         # ReplaySSM-KDA: the accepted drafts live in the per-slot ring (written
@@ -1513,6 +1521,90 @@ class HybridLinearAttnBackend(AttentionBackend):
             mamba_steps_to_track,
         )
 
+    @staticmethod
+    def _commit_gdn_replayssm_after_direct_verify(
+        req_pool,
+        last_correct_step_indices: torch.Tensor,
+        mamba_track_indices: Optional[torch.Tensor],
+        mamba_steps_to_track: Optional[torch.Tensor],
+        req_pool_indices: Optional[torch.Tensor],
+    ) -> bool:
+        """GDN ReplaySSM spec-verify commit for callers that verify a linear chain
+        and commit through this hook directly (DFLASH).
+
+        Same operations, in the same order and on the same index sets, as the GDN
+        circular-ring branch of spec_utils.commit_mamba_states_after_verify, which
+        EAGLE/MTP reaches: advance the per-request ring cursors by the accepted
+        count, fold the ring into `temporal` where it is full or a track crossing
+        needs the exact state, then roll back the conv windows. Returns False when
+        the pool has no GDN spec ring (flag off, or a KDA model).
+        """
+        mamba_pool = getattr(req_pool, "mamba_pool", None)
+        if (
+            mamba_pool is None
+            or getattr(mamba_pool, "replayssm_cache_base", None) is None
+            or getattr(mamba_pool, "replayssm_is_kda", False)
+        ):
+            return False
+        if req_pool_indices is None:
+            raise RuntimeError(
+                "GDN ReplaySSM spec-verify commit needs req_pool_indices from the caller."
+            )
+        if last_correct_step_indices.numel() == 0:
+            return True
+        from sglang.kernels.ops.attention.fla.gdn_replayssm_spec_decode import (
+            commit_gdn_replayssm_circular,
+            commit_gdn_replayssm_spec,
+        )
+
+        spec_state = req_pool.get_speculative_mamba2_params_all_layers()
+        state_batch_indices = req_pool.get_mamba_indices(req_pool_indices)
+        # Linear chain: the accepted count (incl. the bonus token) is the last
+        # accepted step + 1.
+        accept_lens = (last_correct_step_indices + 1).to(torch.int32)
+        commit_gdn_replayssm_spec(
+            write_pos=mamba_pool.replayssm_spec_write_pos,
+            cache_base=mamba_pool.replayssm_cache_base,
+            is_flush=mamba_pool.replayssm_is_flush,
+            num_accepted=accept_lens,
+            replay_indices=req_pool_indices,
+            max_cache_len=spec_state.replayssm_d.shape[-2],
+            max_spec_len=int(get_spec().speculative_num_draft_tokens),
+            fold_every_commit=spec_state.temporal.dtype != torch.float32,
+            null_block_id=-1,
+        )
+        commit_gdn_replayssm_circular(
+            checkpoint_state=spec_state.temporal,
+            d_cache=spec_state.replayssm_d,
+            k_cache=spec_state.replayssm_k,
+            g_cache=spec_state.replayssm_g,
+            d_residual_cache=spec_state.replayssm_rawv,
+            k_residual_cache=spec_state.replayssm_rawk,
+            state_batch_indices=state_batch_indices,
+            replay_indices=req_pool_indices,
+            write_pos=mamba_pool.replayssm_spec_write_pos,
+            cache_base=mamba_pool.replayssm_cache_base,
+            is_flush=mamba_pool.replayssm_is_flush,
+            accept_lens=accept_lens,
+            mamba_track_indices=mamba_track_indices,
+            mamba_steps_to_track=mamba_steps_to_track,
+            null_block_id=-1,
+        )
+        fused_conv_window_scatter_with_mask(
+            spec_state.conv[0],
+            spec_state.intermediate_conv_window[0],
+            state_batch_indices,
+            last_correct_step_indices,
+        )
+        if mamba_track_indices is not None:
+            fused_conv_window_scatter_with_mask(
+                spec_state.conv[0],
+                spec_state.intermediate_conv_window[0],
+                mamba_track_indices,
+                mamba_steps_to_track,
+            )
+        return True
+
     @staticmethod
     def _scatter_speculative_state_with_mask(
         dst: torch.Tensor,
diff --git a/python/sglang/srt/mem_cache/kv_cache_configurator.py b/python/sglang/srt/mem_cache/kv_cache_configurator.py
index da2b357e62..35bc56db5c 100644
--- a/python/sglang/srt/mem_cache/kv_cache_configurator.py
+++ b/python/sglang/srt/mem_cache/kv_cache_configurator.py
@@ -1124,17 +1124,22 @@ class KVCacheConfigurator:
         max_num_reqs: int,
         extra_max_context_len: int,
     ) -> ReqToTokenPool:
-        # DSPARK/DFLASH commit routes through the backend fold (KDA-only); a
-        # non-KDA model there would scatter a None intermediate_ssm and crash.
+        # DSPARK/DFLASH commit through the backend hook
+        # (update_mamba_state_after_mtp_verify): KDA folds there, and GDN takes
+        # the circular-ring commit for DFLASH's linear chain. DSPARK on GDN is not
+        # wired; it would scatter a None intermediate_ssm and crash.
         _algo = (get_spec().speculative_algorithm or "").upper()
         if (
             get_exec().mamba.enable_linear_replayssm_spec
-            and _algo in ("DSPARK", "DFLASH")
             and self.hybrid_kda_config is None
+            and (
+                _algo == "DSPARK"
+                or (_algo == "DFLASH" and self.hybrid_gdn_config is None)
+            )
         ):
             raise ValueError(
-                "--enable-linear-replayssm-spec with DSPARK/DFLASH requires a KDA "
-                "model; got a non-KDA model."
+                "--enable-linear-replayssm-spec with DSPARK requires a KDA model, and "
+                "with DFLASH a KDA or GDN model."
             )
         req_to_token_pool = HybridReqToTokenPool(
             size=max_num_reqs,
-- 
2.34.1

