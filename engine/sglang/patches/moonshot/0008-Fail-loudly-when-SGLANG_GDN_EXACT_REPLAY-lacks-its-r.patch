From 1101be8c5f87d630d9df4f86527ddbf04aa9e212 Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Wed, 30 Sep 2026 21:17:38 +0000
Subject: [PATCH 8/8] Fail loudly when SGLANG_GDN_EXACT_REPLAY lacks its ring,
 and log the dispatch

The flag without --enable-linear-replayssm (no beta ring or write cursor) used to
fall through to the ordinary kernels; it now raises. The first exact-replay
dispatch is logged so server logs show which decode kernel ran.
---
 .../attention/linear/kernels/gdn_triton.py    | 29 +++++++++++++++----
 1 file changed, 24 insertions(+), 5 deletions(-)

diff --git a/python/sglang/srt/layers/attention/linear/kernels/gdn_triton.py b/python/sglang/srt/layers/attention/linear/kernels/gdn_triton.py
index d2795db7ed..d606d2cd62 100644
--- a/python/sglang/srt/layers/attention/linear/kernels/gdn_triton.py
+++ b/python/sglang/srt/layers/attention/linear/kernels/gdn_triton.py
@@ -1,3 +1,5 @@
+import logging
+
 import torch
 
 from sglang.srt.environ import envs
@@ -6,6 +8,8 @@ from sglang.srt.layers.attention.linear.kernels.kernel_backend import (
 )
 from sglang.srt.utils import is_cpu, is_npu, is_xpu
 
+logger = logging.getLogger(__name__)
+
 if not is_cpu():
     from sglang.kernels.ops.attention.fla.chunk import chunk_gated_delta_rule
     from sglang.kernels.ops.attention.fla.fused_recurrent import (
@@ -41,6 +45,16 @@ elif is_xpu():
     )
 
 
+_exact_replay_logged = False
+
+
+def _log_exact_replay_once(ring_len: int) -> None:
+    global _exact_replay_logged
+    if not _exact_replay_logged:
+        logger.info("GDN decode: exact replay kernel, ring length %d", ring_len)
+        _exact_replay_logged = True
+
+
 class TritonGDNKernel(LinearAttnKernelBase):
     """Triton-based kernel for GDN (Gated Delta Network) linear attention."""
 
@@ -98,11 +112,16 @@ class TritonGDNKernel(LinearAttnKernelBase):
         # treats None as "no forced flush" (byte-identical to slice 1a/1b).
         replayssm_force_flush = kwargs.get("replayssm_force_flush")
         replayssm_beta = kwargs.get("replayssm_beta")
-        if (
-            replayssm_beta is not None
-            and replayssm_write_pos is not None
-            and envs.SGLANG_GDN_EXACT_REPLAY.get()
-        ):
+        exact_replay = envs.SGLANG_GDN_EXACT_REPLAY.get()
+        if exact_replay and (replayssm_beta is None or replayssm_write_pos is None):
+            # The flag without the ring (e.g. no --enable-linear-replayssm) must not
+            # fall back silently.
+            raise RuntimeError(
+                "SGLANG_GDN_EXACT_REPLAY=1 needs --enable-linear-replayssm and an FP32 "
+                "state (the beta ring or the write cursor is missing)"
+            )
+        if exact_replay:
+            _log_exact_replay_once(replayssm_beta.shape[-1])
             # Rounding-preserving replay: bit-identical to the packed decode below.
             fused_recurrent_gdn_exact_replay_decode(
                 mixed_qkv=mixed_qkv,
