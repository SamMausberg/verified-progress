From d28fc494e25042d7c23cfd11b447766d11fe0f52 Mon Sep 17 00:00:00 2001
From: Samuel Mausberg <samuelmausberg@gmail.com>
Date: Thu, 1 Oct 2026 03:17:11 +0000
Subject: [PATCH 9/9] Exact replay: SGLANG_GDN_EXACT_REPLAY_BV selects the
 value tile (default 32, as the packed decode)

---
 .../ops/attention/fla/fused_recurrent_exact_replay.py    | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/python/sglang/kernels/ops/attention/fla/fused_recurrent_exact_replay.py b/python/sglang/kernels/ops/attention/fla/fused_recurrent_exact_replay.py
index 0d16d638fd..08abfd7085 100644
--- a/python/sglang/kernels/ops/attention/fla/fused_recurrent_exact_replay.py
+++ b/python/sglang/kernels/ops/attention/fla/fused_recurrent_exact_replay.py
@@ -30,6 +30,7 @@ ReplaySSM's, so the same pool plumbing drives it.
 
 from __future__ import annotations
 
+import os
 from typing import Optional
 
 import torch
@@ -211,7 +212,13 @@ def fused_recurrent_gdn_exact_replay_decode(
     BK = triton.next_power_of_2(K)
     if BK != K:
         raise ValueError("exact replay supports power-of-two K only (one K tile)")
-    BV = min(triton.next_power_of_2(V), 32)
+    # The packed decode uses BV = 32; a narrower tile gives more programs (more latency
+    # hiding for the replay loop). Each row's K reduction is unchanged, but bit-equality
+    # with the packed decode must be re-checked for any other BV.
+    BV = min(
+        triton.next_power_of_2(V),
+        int(os.environ.get("SGLANG_GDN_EXACT_REPLAY_BV", "32")),
+    )
     grid = (triton.cdiv(V, BV), B * HV)
     gdn_exact_replay_decode_kernel[grid](
         mixed_qkv=mixed_qkv,
-- 
