+def _same_weight(weight: torch.Tensor, head: Any) -> bool:
+    """The caller's head tensor is the bytes the certified head's fallback reads."""
+    w = head.head.weight
+    return (
+        weight.data_ptr() == w.data_ptr()
+        and tuple(weight.shape) == tuple(w.shape)
+        and weight.stride() == w.stride()
+    )
+
+
+def _capturable(path: str, hidden: torch.Tensor, weight: torch.Tensor):
+    """The path's state and head if ``hidden`` can use the certified head now.
+
+    Outside capture (graph warm-up or an eager forward) it compiles and
+    self-tests this shape once and returns None, so the stock head runs.
+    """
+    st = _state.get(path)
+    if st is None:
+        return None
+    head = _heads.get(path)
+    m = hidden.shape[0]
+    ok = (
+        hidden.dtype == torch.bfloat16
+        and hidden.is_contiguous()
+        and head.supports(m)
+        and _same_weight(weight, head)
+    )
+    if not torch.cuda.is_current_stream_capturing():
+        if ok:
+            head.warm(hidden, check=_heads.flags.check)
+        return None
+    (st.covered if ok else st.uncovered).add(m)
+    return (st, head) if ok else None
+
+
