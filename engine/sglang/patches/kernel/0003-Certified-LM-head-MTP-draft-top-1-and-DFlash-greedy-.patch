+                hs, self.weight[: self.num_org], self.out, stock
+            ):
+                stock()
             return
+        logits = torch.matmul(hs, self.weight[: self.num_org].T)
         local_max = self.local_max[:n]
         local_arg = self.local_arg[:n]
         torch.max(logits, dim=-1, out=(local_max, local_arg))
