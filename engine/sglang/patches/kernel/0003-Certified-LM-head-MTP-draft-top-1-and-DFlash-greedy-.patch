+def draft_topk1(
+    stock: Callable[[], Tuple[torch.Tensor, torch.Tensor]],
+    positions: torch.Tensor,
+    draft_tokens: Optional[torch.Tensor],
+    column: int,
+) -> Tuple[torch.Tensor, torch.Tensor]:
+    """``draft_topk1_postprocess`` for an MTP draft step inside the draft graph.
+
+    If the step's head was captured with the certified head, the stock top-1
+    runs under ``not gate`` and, under ``gate``, the certified ids take its place
+    with the same side effects (positions advanced, draft token column written).
+    """
+    global _draft_step
+    step, _draft_step = _draft_step, None
+    if step is None or not torch.cuda.is_current_stream_capturing():
+        return stock()
+    from torch._higher_order_ops.cudagraph_conditional_nodes import _if_body
+
+    ids, gate = step
+    bs = ids.shape[0]
+    topk_p = torch.ones((bs, 1), dtype=torch.float32, device=ids.device)
+    topk_index = torch.empty((bs, 1), dtype=torch.int64, device=ids.device)
+    with _if_body(torch.logical_not(gate)):
+        topk_index.copy_(stock()[1])
+    with _if_body(gate):
+        topk_index.copy_(ids.view(bs, 1))
+        positions.add_(1)
+        if draft_tokens is not None:
+            draft_tokens[:, column].copy_(ids)
+    return topk_p, topk_index
+
+
+def gated_draft_sample(
+    hidden: torch.Tensor,
+    weight: torch.Tensor,
+    out: torch.Tensor,
+    stock: Callable[[], None],
+) -> bool:
+    """DFlash's in-graph greedy draft projection (``_DflashDraftSampler``).
+
+    Under capture, writes ``out[:n]`` from the certified head under the gate and
+    from ``stock`` under its negation, and returns True; otherwise returns False
+    and the caller runs ``stock``.
+    """
+    found = _capturable("dflash_draft", hidden, weight)
+    if found is None:
+        return False
+    st, head = found
+    from torch._higher_order_ops.cudagraph_conditional_nodes import _if_body
+
+    n = hidden.shape[0]
+    if _heads.flags.check:
+        stock()
+        ids = head.argmax(hidden, gate=st.gate, valid=st.valid, stock_ids=out[:n])
+    else:
+        ids = head.argmax(hidden, gate=st.gate, valid=st.valid)
+        with _if_body(torch.logical_not(st.gate)):
+            stock()
+    with _if_body(st.gate):
+        out[:n].copy_(ids)
+    return True
+
+
+def set_gate(path: str, rows: int, eligible: bool = True) -> bool:
+    """Before a replay of the path's graph: certify iff eligible and the padded
+    graph for ``rows`` was captured with the certified head."""
+    st = _state.get(path)
+    if st is None:
+        return False
+    limit = envs.SGLANG_CERTIFIED_HEAD_MAX_ROWS.get()
+    certify = bool(eligible) and rows <= st.max_rows(limit)
+    st.gate.fill_(certify)
+    st.valid.fill_(rows)
+    st.steps["certified" if certify else "stock_graph"] += 1
+    _maybe_dump()  # reads the counters of earlier replays
+    return certify
+
+
+def attach_ids(path: str, logits_output: LogitsProcessorOutput, rows: int) -> None:
+    """After a certified replay whose argmax runs outside the graph: copy the ids
+    out of the head's buffer onto the output, before the next replay."""
+    logits_output.certified_ids = _heads.get(path).head._ids[:rows].clone()
+    _maybe_dump()
+
+
+def mtp_draft_eligible(topk: int) -> bool:
+    """MTP drafting is greedy top-1 whatever the requests' sampling parameters,
+    unless draft proposals are sampled for rejection sampling."""
+    from sglang.srt.runtime_context import get_spec
+
+    return topk == 1 and not get_spec().speculative_use_rejection_sampling


