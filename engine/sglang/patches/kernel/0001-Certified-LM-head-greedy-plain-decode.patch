 python/sglang/srt/layers/certified_head.py    | 273 ++++++++++++++++++
 python/sglang/srt/layers/logits_processor.py  |  15 +-
 .../sglang/srt/model_executor/model_runner.py |  16 +-
 4 files changed, 321 insertions(+), 3 deletions(-)
