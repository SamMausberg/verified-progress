+        # Sampled verify: per-row seed, position and temperature, filled before a
+        # replay (padding rows keep earlier, valid values).
+        self.seeds = torch.zeros(_MAX_ROWS, dtype=torch.int64, device=device)
+        self.positions = torch.zeros(_MAX_ROWS, dtype=torch.int64, device=device)
+        self.temps = torch.ones(_MAX_ROWS, dtype=torch.float32, device=device)

     def max_rows(self, limit: int) -> int:
         """Largest row count whose padded graph certainly has the certified head."""
