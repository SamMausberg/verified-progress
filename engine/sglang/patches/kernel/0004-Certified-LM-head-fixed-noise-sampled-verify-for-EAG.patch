         return True
@@ -363,10 +395,37 @@ def _needs_logits(forward_batch: ForwardBatch, observer: Any) -> bool:
     )


+def _greedy_eligible(forward_batch: ForwardBatch, observer: Any) -> bool:
+    si = forward_batch.sampling_info
+    return (
+        si is not None
+        and si.is_all_greedy
+        and not _adjusts_logits(forward_batch, observer)
+    )
+
+
+def _fixed_noise_eligible(model_runner, forward_batch: ForwardBatch) -> bool:
+    """Fixed-noise sampled verify: EAGLE/MTP, every request seeded and sampled
+    with temperature only (no top-k, top-p or min-p), no logit adjustments."""
+    from sglang.srt.runtime_context import get_spec
+
+    si = forward_batch.sampling_info
+    return (
+        si is not None
+        and not si.is_all_greedy
+        and si.sampling_seed is not None
+        and not (si.need_top_k_sampling or si.need_top_p_sampling)
+        and not si.need_min_p_sampling
+        and not model_runner.spec_algorithm.is_dflash_family()
+        and not get_spec().speculative_use_rejection_sampling
+        and not _adjusts_logits(forward_batch, model_runner.sampling_observer)
+    )
+
+
 def before_replay(
     model_runner, forward_batch: ForwardBatch, can_run_graph: bool
 ) -> None:
-    """Set the gate for the ModelRunner graph replay about to run."""
+    """Set the gates for the ModelRunner graph replay about to run."""
     if _heads is None:
         return
     mode = forward_batch.forward_mode
@@ -380,22 +439,42 @@ def before_replay(
             else:
                 _state["dflash_draft"].steps["eager"] += 1
         return
-    path = _path_for("target", mode)
-    st = _state.get(path) if path is not None else None
-    if st is None:
+    paths = [p for p in _paths_for("target", mode) if p in _state]
+    if not paths:
         return
-    forward_batch.certified_rows = None
+    forward_batch.certified_path = None
     if not can_run_graph:
-        st.steps["eager"] += 1
+        for path in paths:
+            _state[path].steps["eager"] += 1
         return
     # Decode rows are requests; verify rows are requests x draft tokens. CUDA-graph
     # padding follows the real rows.
     rows = int(forward_batch.input_ids.shape[0])
-    eligible = not _needs_logits(
-        forward_batch, model_runner.sampling_observer
-    ) and not (path == "verify" and _verify_needs_logits(model_runner))
-    if set_gate(path, rows, eligible):
-        forward_batch.certified_rows = rows
+    verify_ok = not (mode.is_target_verify() and _verify_needs_logits(model_runner))
+    observer = model_runner.sampling_observer
+    chosen = None
+    for path in paths:
+        if path == "sampled_verify":
+            eligible = chosen is None and _fixed_noise_eligible(
+                model_runner, forward_batch
+            )
+            if eligible:
+                _stage_sampling(_state[path], forward_batch, rows)
+        else:
+            eligible = _greedy_eligible(forward_batch, observer)
+        if set_gate(path, rows, eligible and verify_ok) and chosen is None:
+            chosen = path
+    forward_batch.certified_path = chosen
+    forward_batch.certified_rows = rows
+
+
+def _stage_sampling(st: _PathState, forward_batch: ForwardBatch, rows: int) -> None:
+    """Per-row seed, position and temperature for the sampled-verify head."""
+    si = forward_batch.sampling_info
+    per_req = rows // forward_batch.batch_size
+    st.seeds[:rows].copy_(si.sampling_seed.view(-1).repeat_interleave(per_req))
+    st.positions[:rows].copy_(forward_batch.positions[:rows])
+    st.temps[:rows].copy_(si.temperatures.view(-1).float().repeat_interleave(per_req))


 def _verify_needs_logits(model_runner) -> bool:
@@ -410,10 +489,24 @@ def after_replay(
     model_runner, forward_batch: ForwardBatch, logits_output: LogitsProcessorOutput
 ) -> None:
     """Copy the certified ids out of the head's buffer before the next replay."""
-    rows = getattr(forward_batch, "certified_rows", None)
-    if rows is None:
+    path = getattr(forward_batch, "certified_path", None)
+    if path is not None:
+        attach_ids(path, logits_output, forward_batch.certified_rows)
+
+
+def check_fixed_noise(next_token_logits: torch.Tensor, ids: torch.Tensor) -> None:
+    """Check mode for sampled verify: compare the certified samples with SGLang's
+    seeded sampler applied to the same verify logits (valid in check mode)."""
+    if _heads is None or not _heads.flags.check:
         return
-    attach_ids(_path_for("target", forward_batch.forward_mode), logits_output, rows)
+    from certified_head.reference import stock_seeded_sample_from_logits
+
+    st = _state["sampled_verify"]
+    n = ids.shape[0]
+    stock = stock_seeded_sample_from_logits(
+        next_token_logits[:n], st.seeds[:n], st.positions[:n], st.temps[:n]
+    )
+    _heads.get("sampled_verify").add_mismatches(ids, stock)


 def take_ids(logits_output: LogitsProcessorOutput) -> Optional[torch.Tensor]:
