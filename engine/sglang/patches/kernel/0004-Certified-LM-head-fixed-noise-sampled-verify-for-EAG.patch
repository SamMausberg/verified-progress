-    if path == "draft":
-        _draft_step = (ids, st.gate)
     return logits


@@ -341,9 +372,10 @@ def mtp_draft_eligible(topk: int) -> bool:
     return topk == 1 and not get_spec().speculative_use_rejection_sampling


-def _needs_logits(forward_batch: ForwardBatch, observer: Any) -> bool:
+def _adjusts_logits(forward_batch: ForwardBatch, observer: Any) -> bool:
+    """The batch changes or reads the logits besides picking its tokens."""
     si = forward_batch.sampling_info
-    if si is None or not si.is_all_greedy or forward_batch.return_logprob:
+    if si is None or forward_batch.return_logprob:
