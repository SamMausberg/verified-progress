     ):
-        # Certified LM head: the stock argmax's tokens, computed without logits.
-        target_predict = certified_head.take_ids(logits_output)
+        target_predict = certified_ids
         if target_predict is None:
             target_predict = torch.argmax(next_token_logits, dim=-1)
         target_predict = target_predict.reshape(bs, verify_input.draft_token_num)
@@ -846,6 +847,25 @@ def eagle_sample(
                 tp_group.broadcast(predict, src=0)
                 tp_group.broadcast(accept_index, src=0)
                 tp_group.broadcast(num_correct_drafts, src=0)
+    elif certified_ids is not None:
+        # Fixed-noise sampled verification (SGLANG_CERTIFIED_HEAD_SAMPLED_VERIFY):
+        # each verify row's token is SGLang's seeded sample of that row's logits
+        # (seed, position, temperature). A draft token is accepted iff it equals
+        # the sample, and the sample is emitted at the first mismatch or as the
+        # bonus: equal in law to target sampling and independent of the drafter.
+        certified_head.check_fixed_noise(next_token_logits, certified_ids)
+        target_predict = certified_ids.reshape(bs, verify_input.draft_token_num)
+        predict, accept_index, num_correct_drafts = verify_tree_greedy_func(
