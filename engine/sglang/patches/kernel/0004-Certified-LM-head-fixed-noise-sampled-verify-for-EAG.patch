     Returns None when the stock head should run as usual. Under capture it
-    records the certified head under the path's gate and the stock head under
-    its negation, and returns the stock logits tensor (stale when the gate held).
+    records each path's certified head under that path's gate and the stock
+    head under the negation of all of them, and returns the stock logits
+    tensor (stale when a gate held). A target verify graph serves both greedy
+    verify and fixed-noise sampled verify; at most one gate holds per replay.
     """
     global _draft_step
-    path = _path_for(role, forward_mode)
-    if path == "draft":
+    paths = _paths_for(role, forward_mode)
+    if "draft" in paths:
         _draft_step = None
-    found = _capturable(path, hidden, lm_head.weight) if path is not None else None
-    if found is None:
+    found = []
+    for path in paths:
+        got = _capturable(path, hidden, lm_head.weight)
+        if got is not None:
+            found.append((path, *got))
+    if not found:
         return None
-    st, head = found
     from torch._higher_order_ops.cudagraph_conditional_nodes import _if_body

-    if _heads.flags.check:
-        # Validation: always run the stock head and count rows whose tokens differ.
-        logits = stock_logits()
-        ids = head.argmax(
-            hidden,
-            gate=st.gate,
-            valid=st.valid,
-            stock_ids=torch.argmax(logits, dim=-1),
-        )
-    else:
-        ids = head.argmax(hidden, gate=st.gate, valid=st.valid)
+    check = _heads.flags.check
+    # Validation: always run the stock head and count rows whose tokens differ
+    # (sampled verify is compared outside the graph, in check_fixed_noise).
+    logits = stock_logits() if check else None
+    gates = []
+    m = hidden.shape[0]
+    for path, st, head in found:
+        if path == "sampled_verify":
+            ids = head.gumbel_sample(
+                hidden,
+                st.seeds[:m],
+                st.positions[:m],
+                st.temps[:m],
+                gate=st.gate,
+                valid=st.valid,
+            )
+        else:
+            stock_ids = torch.argmax(logits, dim=-1) if check else None
+            ids = head.argmax(hidden, gate=st.gate, valid=st.valid, stock_ids=stock_ids)
+        if path == "draft":
+            _draft_step = (ids, st.gate)
+        gates.append(st.gate)
+    if logits is None:
+        certified = gates[0]
+        for gate in gates[1:]:
+            certified = torch.logical_or(certified, gate)
         out = []
-        with _if_body(torch.logical_not(st.gate)):
+        with _if_body(torch.logical_not(certified)):
             out.append(stock_logits())
